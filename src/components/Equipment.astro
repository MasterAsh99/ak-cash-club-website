---
/**
 * Equipment section: the table and the cards.
 * Links live in src/config/site.ts → `links`.
 */
import SectionHeading from './SectionHeading.astro';
import { links } from '../config/site';

const items = [
  {
    eyebrow: 'The table',
    title: 'Manhattan-style, blue felt',
    body: [
      'Our main table is a Manhattan-style poker table with box legs and blue felt. It comes from Straight Poker Supplies, which hand-builds its tables in Toronto.',
      'It’s a full-size table built for poker, not a folding card table.',
    ],
    href: links.manhattanTable,
    cta: 'See the Manhattan tables',
  },
  {
    eyebrow: 'The cards',
    title: 'KEM, poker size',
    body: [
      'We deal KEM poker-size cards. They’re made of 100% cellulose acetate plastic instead of paper, so they shuffle cleanly and don’t bend, mark or stick together.',
      'KEM cards are used in casino poker rooms and are the official cards of the World Series of Poker.',
    ],
    href: links.kemCards,
    cta: 'See the cards we use',
  },
];
---

<section id="equipment" class="relative py-24 sm:py-32" aria-labelledby="equipment-title">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading eyebrow="Equipment" title="The table and the cards." id="equipment-title" />

    <p class="mt-8 max-w-2xl text-base leading-relaxed text-silver-300 sm:text-lg" data-reveal>
      Most of our equipment comes from{' '}
      <a
        href={links.straightPoker}
        target="_blank"
        rel="noopener"
        class="text-silver-50 underline decoration-silver-100/30 underline-offset-4 transition hover:decoration-silver-100"
        >Straight Poker Supplies</a
      >, a Canadian poker supply company. We bought the best quality we could find, because good
      equipment makes the game run better.
    </p>

    <ul class="mt-12 grid gap-4 md:grid-cols-2">
      {
        items.map((item, i) => (
          <li class="panel flex flex-col p-8 sm:p-10" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <p class="eyebrow">{item.eyebrow}</p>
            <h3 class="mt-4 text-3xl">{item.title}</h3>
            <div class="mt-4 space-y-3 leading-relaxed text-silver-300">
              {item.body.map((para) => <p>{para}</p>)}
            </div>
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              class="group mt-8 inline-flex items-center gap-2 self-start text-sm font-medium tracking-wide text-silver-50"
            >
              <span class="underline decoration-silver-100/30 underline-offset-4 transition group-hover:decoration-silver-100">
                {item.cta}
              </span>
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              <span class="sr-only">(opens Straight Poker Supplies in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
