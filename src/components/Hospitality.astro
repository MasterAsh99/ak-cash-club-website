---
import SectionHeading from './SectionHeading.astro';

const tiles = [
  { label: 'Food', value: 'Complimentary' },
  { label: 'Non-alcoholic drinks', value: 'Complimentary' },
  { label: 'Alcohol', value: 'Bring your own' },
];
---

<section id="hospitality" class="relative py-24 sm:py-32" aria-labelledby="hospitality-title">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="panel relative overflow-hidden px-6 py-16 sm:px-14 sm:py-20">
      <!-- soft spotlight -->
      <div
        class="pointer-events-none absolute -top-1/2 left-1/2 h-[120%] w-[90%] -translate-x-1/2 rounded-[50%] bg-[radial-gradient(closest-side,rgb(112_150_212/0.12),transparent)]"
        aria-hidden="true"
      >
      </div>

      <div class="relative grid gap-12 lg:grid-cols-2 lg:items-end">
        <SectionHeading eyebrow="Food & Drinks" title="On the house." id="hospitality-title" />

        <p class="text-base leading-relaxed text-silver-300 sm:text-lg" data-reveal>
          Food and non-alcoholic drinks are complimentary for every player at the table. There’s
          nothing to bring and nothing to pay for. Take your seat and enjoy the game.
        </p>
      </div>

      <ul class="relative mt-14 grid gap-px overflow-hidden rounded-xl border border-silver-100/10 bg-silver-100/10 sm:grid-cols-3">
        {
          tiles.map((t, i) => (
            <li class="bg-midnight-900 p-6 sm:p-8" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <p class="eyebrow">{t.label}</p>
              <p class="mt-3 font-serif text-3xl text-silver-50">{t.value}</p>
            </li>
          ))
        }
      </ul>

      <!-- Alcohol policy -->
      <div
        class="relative mt-6 rounded-xl border border-steel-400/30 bg-steel-600/10 p-6 sm:p-8"
        role="note"
        aria-labelledby="alcohol-policy-title"
        data-reveal
      >
        <h3 id="alcohol-policy-title" class="font-sans text-sm font-semibold tracking-[0.16em] text-silver-50 uppercase">
          Alcohol policy
        </h3>
        <p class="mt-3 leading-relaxed text-silver-200">
          Our hosts do not serve alcohol under any circumstances. If you’d like to enjoy a drink
          during the game, you’re welcome to bring your own (BYOB).
        </p>
      </div>
    </div>
  </div>
</section>
