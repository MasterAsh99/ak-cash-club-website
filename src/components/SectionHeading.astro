---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, id, align = 'left' } = Astro.props;
---

<header class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-4 text-4xl leading-[1.05] sm:text-5xl">{title}</h2>
  <div class:list={['hairline mt-7 w-24', align === 'center' && 'mx-auto']}></div>
</header>
