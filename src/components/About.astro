---
import SectionHeading from './SectionHeading.astro';

const pillars = [
  {
    title: 'Private by design',
    body: 'A home game, not a casino floor. Seats are arranged directly with the club, and the location is shared only with confirmed players.',
  },
  {
    title: 'A table worth sitting at',
    body: 'A comfortable, focused game where regulars and newcomers alike are treated well and the action stays friendly.',
  },
  {
    title: 'Hosted properly',
    body: 'Complimentary food and drinks through the night, so the only thing you need to bring is your game.',
  },
];
---

<section id="about" class="relative py-24 sm:py-32" aria-labelledby="about-title">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 sm:px-8 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <SectionHeading eyebrow="The Club" title="Welcome to the table." id="about-title" />
      <div class="mt-8 space-y-5 text-base leading-relaxed text-silver-300 sm:text-lg" data-reveal>
        <p>
          AK Cash Club is a private poker home game in London, Ontario, built around one idea: the
          best nights at the table come from good people and a game that’s run with care.
        </p>
        <p>
          It’s relaxed enough to enjoy and serious enough to respect. Whether you’re a regular or
          looking for your first seat, you’ll be welcomed in.
        </p>
      </div>
    </div>

    <ul class="grid gap-4 self-end">
      {
        pillars.map((p, i) => (
          <li class="panel p-6 sm:p-8" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <div class="flex items-baseline gap-5">
              <span class="font-serif text-sm text-steel-400 tabular-nums" aria-hidden="true">
                0{i + 1}
              </span>
              <div>
                <h3 class="text-2xl">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-silver-300">{p.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
