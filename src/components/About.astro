---
import SectionHeading from './SectionHeading.astro';

const points = [
  {
    title: 'A seat reserved for you',
    body: 'Seats are arranged personally over Instagram. Once yours is confirmed, we send the address directly to you.',
  },
  {
    title: 'Equipment worth playing on',
    body: 'A full-size Manhattan-style table from Straight Poker Supplies, and KEM plastic cards, the same brand dealt at the World Series of Poker.',
  },
  {
    title: 'Looked after all game',
    body: 'Food and non-alcoholic drinks are complimentary. We don’t serve alcohol, but you’re welcome to bring your own.',
  },
];
---

<section id="about" class="relative py-24 sm:py-32" aria-labelledby="about-title">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 sm:px-8 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <SectionHeading eyebrow="The Club" title="A private game, hosted properly." id="about-title" />
      <div class="mt-8 space-y-5 text-base leading-relaxed text-silver-300 sm:text-lg" data-reveal>
        <p>
          AK Cash Club is a private poker game held in a home in London, Ontario. It isn’t a
          casino floor or a public card room. It’s a smaller, more personal game, where every
          player is confirmed in advance and the address is shared only with those who have a
          seat.
        </p>
        <p>
          We play No-Limit Texas Hold’em cash games at low-to-medium stakes. Whether you’ve played
          for years or are newer to the game, you’ll find a comfortable seat and a table that’s run
          with care.
        </p>
      </div>
    </div>

    <ul class="grid gap-4 self-end">
      {
        points.map((p, i) => (
          <li class="panel p-6 sm:p-8" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <div class="flex items-baseline gap-5">
              <span class="font-serif text-sm text-steel-400 tabular-nums" aria-hidden="true">
                0{i + 1}
              </span>
              <div>
                <h3 class="text-2xl">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-silver-300">{p.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
