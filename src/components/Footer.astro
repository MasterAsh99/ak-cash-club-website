---
import Logo from './Logo.astro';
import InstagramIcon from './InstagramIcon.astro';
import { instagramUrl, site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-silver-100/10 bg-ink">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
      <Logo />
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm text-silver-300 transition-colors hover:text-silver-50"
      >
        <InstagramIcon />
        @{site.instagramHandle}
      </a>
    </div>

    <div class="hairline my-10"></div>

    <div class="grid gap-6 text-xs leading-relaxed text-silver-500 sm:grid-cols-2">
      <p>
        {site.name} is a private home game in {site.city}. This website is informational only: it
        offers no online gambling and takes no payments. Players must be of legal age in Ontario.
      </p>
      <p class="sm:text-right">
        Please play responsibly. Free, confidential support is available through{' '}
        <a href="https://www.connexontario.ca/" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-silver-300">ConnexOntario</a>.
        <br />
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>
