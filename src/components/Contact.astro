---
import InstagramIcon from './InstagramIcon.astro';
import { instagramDmUrl, instagramUrl, site } from '../config/site';

const steps = [
  { title: 'Follow', body: `Follow @${site.instagramHandle} to see upcoming games and promotions.` },
  { title: 'Message', body: 'Send us a DM to reserve a seat. We’re happy to answer any questions about the game or the stakes.' },
  { title: 'Confirm', body: 'Once your seat is confirmed, we’ll send the address to you privately.' },
];
---

<section id="contact" class="relative isolate overflow-hidden py-28 sm:py-36" aria-labelledby="contact-title">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(90%_70%_at_50%_100%,#16243f_0%,#0a1120_45%,#05070c_80%)]"></div>
    <div class="hairline absolute inset-x-0 top-0"></div>
  </div>

  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p class="eyebrow" data-reveal>Join us</p>
    <h2 id="contact-title" class="mt-5 text-[clamp(2.6rem,9vw,5rem)] leading-[1]" data-reveal style="--reveal-delay:100ms">
      Reserve your <span class="text-metal italic">seat</span>.
    </h2>
    <p class="mx-auto mt-7 max-w-lg text-base leading-relaxed text-silver-300 sm:text-lg" data-reveal style="--reveal-delay:200ms">
      Every seat at AK Cash Club is arranged personally through Instagram direct message. Send us a
      note, and we’ll take care of the rest.
    </p>

    <div class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center" data-reveal style="--reveal-delay:300ms">
      <a href={instagramDmUrl} target="_blank" rel="noopener" class="btn-primary">
        <InstagramIcon />
        Message us on Instagram
      </a>
      <a href={instagramUrl} target="_blank" rel="noopener" class="btn-ghost">
        View @{site.instagramHandle}
      </a>
    </div>

    <ol class="mt-20 grid gap-px overflow-hidden rounded-2xl border border-silver-100/10 bg-silver-100/10 text-left sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="bg-midnight-950/90 p-6 sm:p-7" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <span class="font-serif text-sm text-steel-400 tabular-nums" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-3 text-2xl">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-silver-300">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
