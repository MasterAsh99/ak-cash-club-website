---
/**
 * Promotions overview.
 * Describes the types of promotions only. Specific amounts, qualifying hands
 * and dates change, so they're announced on Instagram rather than hard-coded.
 */
import SectionHeading from './SectionHeading.astro';
import InstagramIcon from './InstagramIcon.astro';
import { instagramUrl, site } from '../config/site';

const promos = [
  {
    suit: '♠',
    title: 'High Hands',
    body: 'Make a qualifying hand and you’re paid a bonus on top of the pot. The qualifying hands and what they pay are announced on Instagram.',
  },
  {
    suit: '♦',
    title: 'Jackpots',
    body: 'A larger prize, reserved for a rarer hand or moment at the table. The current jackpot and how it’s won are always posted on Instagram.',
  },
];
---

<section id="promotions" class="relative py-24 sm:py-32" aria-labelledby="promotions-title">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading eyebrow="Promotions" title="High hands & jackpots." id="promotions-title" />

    <ul class="mt-14 grid gap-4 md:grid-cols-2">
      {
        promos.map((p, i) => (
          <li class="panel group p-8 sm:p-10" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <span
              class="font-serif text-5xl leading-none text-steel-400 transition-colors duration-500 group-hover:text-silver-100"
              aria-hidden="true"
            >
              {p.suit}
            </span>
            <h3 class="mt-8 text-3xl">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-silver-300">{p.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-silver-400" data-reveal>
      Promotions are refreshed from game to game. See the latest on
      <a href={instagramUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-silver-100 underline decoration-silver-100/30 underline-offset-4 hover:decoration-silver-100">
        <InstagramIcon class="size-3.5" />@{site.instagramHandle}
      </a>
    </p>
  </div>
</section>
