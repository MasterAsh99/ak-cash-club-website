---
import Field from './Field.astro';
import Alert from './Alert.astro';
import type { GameNightForm } from '../../lib/games';

interface Props {
  values: GameNightForm;
  errors: Record<string, string>;
  isEdit: boolean;
  formError?: string;
}
const { values, errors, isEdit, formError = '' } = Astro.props;
const [date = '', time = ''] = values.starts_local.split('T');
---

<form method="post" class="grid gap-5 sm:grid-cols-2" novalidate>
  <input type="hidden" name="action" value="save" />
  {formError && <div class="sm:col-span-2"><Alert tone="error">{formError}</Alert></div>}
  <Field label="Date" name="date" type="date" value={date} required error={errors.date} />
  <Field label="Start time (Toronto time)" name="time" type="time" value={time} required error={errors.time} />
  <Field label="Stakes" name="stakes" value={values.stakes} required maxlength={40} placeholder="$1/$2" error={errors.stakes} />
  <Field label="Table capacity (seats)" name="seats" type="number" inputmode="numeric" min={2} max={12} value={Number.isFinite(values.seats) ? String(values.seats) : ''} required error={errors.seats} />
  <div class="sm:col-span-2">
    <Field label="Game" name="game_type" value={values.game_type} maxlength={60} placeholder="No-Limit Texas Hold’em" hint="Leave blank for No-Limit Texas Hold’em." />
  </div>
  <div class="sm:col-span-2">
    <label for="notes" class="label">Notes for players (optional)</label>
    <textarea id="notes" name="notes" maxlength="500" rows="3" class="input" placeholder="e.g. Doors at 7. Food from 7:30.">{values.notes}</textarea>
    <p class="hint">Shown to every member on the game page.</p>
  </div>

  <fieldset class="rounded-2xl border border-silver-100/10 p-5 sm:col-span-2">
    <legend class="px-2 text-sm text-silver-200">Private: confirmed players only, on game day</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <Field label="Address" name="address" value={values.address} required maxlength={200} autocomplete="off" error={errors.address} hint="Never shown publicly or put in emails." />
      </div>
      <div class="sm:col-span-2">
        <Field label="Arrival note (optional)" name="arrival_note" value={values.arrival_note} maxlength={300} placeholder="e.g. Park on the street, side door" />
      </div>
    </div>
  </fieldset>

  <fieldset class="sm:col-span-2">
    <legend class="label">Seat requests</legend>
    <div class="mt-2 flex flex-wrap gap-5 text-sm text-silver-200">
      <label class="flex items-center gap-2"><input type="radio" name="status" value="open" checked={values.status === 'open'} class="accent-[#5f8ad3]" /> Open</label>
      <label class="flex items-center gap-2"><input type="radio" name="status" value="closed" checked={values.status === 'closed'} class="accent-[#5f8ad3]" /> Closed (no new requests)</label>
    </div>
  </fieldset>

  <label class="flex items-start gap-3 text-sm text-silver-200 sm:col-span-2">
    <input type="checkbox" name="auto_fill_waitlist" value="yes" checked={values.auto_fill_waitlist} class="mt-1 size-4 accent-[#5f8ad3]" />
    <span>Fill open seats from the waitlist automatically
      <span class="block text-xs text-silver-400">When a confirmed player drops out, the first person on the waitlist gets the seat without you approving it. Leave off to choose yourself.</span></span>
  </label>

  {!isEdit && (
    <label class="flex items-start gap-3 text-sm text-silver-200 sm:col-span-2">
      <input type="checkbox" name="announce" value="yes" checked={values.announce} class="mt-1 size-4 accent-[#5f8ad3]" />
      Email members who asked to hear about new game nights.
    </label>
  )}
  {isEdit && (
    <p class="text-sm text-silver-400 sm:col-span-2">Changing the date or time emails everyone with a seat or request.</p>
  )}

  <div class="sm:col-span-2"><button type="submit" class="btn-primary">{isEdit ? 'Save changes' : 'Create game'}</button></div>
</form>
