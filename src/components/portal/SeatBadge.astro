---
import { SEAT_LABELS, type SeatStatus } from '../../lib/games';
interface Props {
  status: SeatStatus | null;
  position?: number | null;
}
const { status, position = null } = Astro.props;
const tone: Record<SeatStatus, string> = {
  confirmed: 'bg-[#5f8ad3]/15 text-[#bcd0f2] ring-[#5f8ad3]/40',
  requested: 'bg-silver-100/5 text-silver-200 ring-silver-100/20',
  waitlisted: 'bg-silver-100/5 text-silver-200 ring-silver-100/20',
  declined: 'bg-[#d3707f]/10 text-[#ecc0c7] ring-[#d3707f]/30',
  cancelled: 'bg-silver-100/5 text-silver-400 ring-silver-100/10',
};
---

{status && (
  <span class:list={['inline-flex items-center rounded-full px-3 py-1 text-xs font-medium tracking-wide ring-1', tone[status]]}>
    {SEAT_LABELS[status]}{status === 'waitlisted' && position ? ` · #${position}` : ''}
  </span>
)}
