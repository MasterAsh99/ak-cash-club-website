---
/**
 * One upcoming game, as members see it: when, stakes, seats, waitlist, your
 * status, and one clear action (Request a seat / Join the waitlist).
 */
import SeatBadge from './SeatBadge.astro';
import { canRequest, formatGameTime, isFull, myStatus, seatsLeft, type GameNightRow } from '../../lib/games';

interface Props { game: GameNightRow; paused?: boolean; showNotes?: boolean }
const { game: n, paused = false, showNotes = true } = Astro.props;
const full = isFull(n);
const mine = myStatus(n.status, n.my_status);
const offer = !paused && canRequest(n);
---

<article class:list={['panel p-5 sm:p-6', n.status === 'cancelled' && 'opacity-70']}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-2xl leading-tight text-silver-50 sm:text-[1.7rem]">
        <a href={`/games/${n.game_night_id}`} class="hover:text-steel-300">{formatGameTime(n.starts_at)}</a>
      </h3>
      <p class="mt-1 text-sm text-silver-300">{n.stakes} · {n.game_type}</p>
    </div>
    <SeatBadge status={mine} position={n.my_waitlist_position} />
  </div>

  <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <div class="flex gap-1.5"><dt class="text-silver-400">Confirmed</dt><dd class="tabular-nums text-silver-50">{n.confirmed_count}/{n.seats}</dd></div>
    <div class="flex gap-1.5"><dt class="text-silver-400">Waitlist</dt><dd class="tabular-nums text-silver-50">{n.waitlist_count}</dd></div>
    <div>
      <dd class:list={['font-medium', n.status === 'cancelled' ? 'text-[#ecc0c7]' : full ? 'text-[#eedcae]' : 'text-[#bcd0f2]']}>
        {n.status === 'cancelled' ? 'Cancelled'
          : n.status === 'completed' ? 'Played'
          : full ? 'Full'
          : `${seatsLeft(n)} seat${seatsLeft(n) === 1 ? '' : 's'} open`}
        {n.status === 'closed' && ' · requests closed'}
      </dd>
    </div>
  </dl>
  {showNotes && n.notes && <p class="mt-2 text-sm text-silver-400">{n.notes}</p>}

  <div class="mt-5 flex flex-wrap gap-3">
    {offer && (
      <form method="post" action="/games">
        <input type="hidden" name="action" value="request" />
        <input type="hidden" name="id" value={n.game_night_id} />
        <button type="submit" class="btn-primary">{full ? 'Join waitlist' : 'Request a seat'}</button>
      </form>
    )}
    <a href={`/games/${n.game_night_id}`} class="btn-ghost">{offer ? 'Details' : 'View game'}</a>
  </div>
</article>
