---
/** Host area navigation: games first, then results and records. */
interface Props {
  current: 'games' | 'results' | 'players' | 'expenses' | 'audit';
}
const { current } = Astro.props;
const items = [
  { key: 'games', href: '/host', label: 'Games' },
  { key: 'results', href: '/host/sessions', label: 'Results' },
  { key: 'players', href: '/host/players', label: 'Players' },
  { key: 'expenses', href: '/host/expenses', label: 'Expenses' },
  { key: 'audit', href: '/host/audit', label: 'Audit log' },
];
---

<div>
  <nav aria-label="Host" class="-mx-1 overflow-x-auto pb-1 [scrollbar-width:none]">
    <ul class="flex gap-2 px-1 text-sm whitespace-nowrap">
      {items.map((i) => (
        <li>
          <a
            href={i.href}
            aria-current={i.key === current ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-10 items-center rounded-full px-4 transition',
              i.key === current ? 'bg-silver-100 text-midnight-950' : 'border border-silver-100/15 text-silver-200 hover:border-steel-300/50',
            ]}
          >{i.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mt-6"><slot /></div>
</div>
