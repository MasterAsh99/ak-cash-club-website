---
/**
 * Upcoming Games: every upcoming game with one clear action each.
 * Also handles "Request a seat / Join waitlist" posted from the home page.
 */
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import Alert from '../../components/portal/Alert.astro';
import GameCard from '../../components/portal/GameCard.astro';
import PlayPaused from '../../components/portal/PlayPaused.astro';
import { readForm, requireMember } from '../../lib/access';
import { friendlyDbError } from '../../lib/errors';
import type { GameNightRow } from '../../lib/games';
import { onBreak, type Wellbeing } from '../../lib/wellbeing';

const access = await requireMember(Astro);
if (access instanceof Response) return access;
if (access.isHost) return Astro.redirect('/host');
const supabase = Astro.locals.supabase!;

let formError = '';
const form = await readForm(Astro);
if (form && form.get('action') === 'request') {
  const id = String(form.get('id') ?? '');
  const { data, error } = await supabase.rpc('request_seat', { p_id: id, p_note: null });
  if (error) formError = friendlyDbError(error);
  else return Astro.redirect(`/games/${encodeURIComponent(id)}?notice=${data === 'waitlisted' ? 'waitlisted' : 'requested'}`, 303);
}

const [{ data: wb }, { data, error }] = await Promise.all([supabase.rpc('get_my_wellbeing'), supabase.rpc('list_game_nights')]);
const wellbeing = (wb ?? null) as Wellbeing | null;
const paused = onBreak(wellbeing) || Boolean(wellbeing?.limit_reached);
const nights = (data ?? []) as GameNightRow[];
---

<PortalLayout title="Upcoming games" access={access} current="games">
  <header>
    <h1 class="text-4xl sm:text-5xl">Upcoming games</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-silver-400">
      Request a seat and the host confirms it. If a game is full, join the waitlist. The address appears on the game page on game day, for confirmed players only.
    </p>
  </header>

  <PlayPaused wellbeing={wellbeing} />
  {formError && <div class="mt-6" role="alert"><Alert tone="error">{formError}</Alert></div>}
  {error && <div class="mt-6"><Alert tone="error">We couldn’t load the games just now. Please refresh in a moment.</Alert></div>}

  {!error && nights.length === 0 && (
    <section class="panel mt-8 p-8 text-center sm:p-12">
      <h2 class="text-2xl">No games scheduled yet.</h2>
      <p class="mx-auto mt-3 max-w-md text-sm text-silver-300">
        New games appear here as soon as the host opens them. <a class="link" href="/account#notifications">Get an email</a> when they do.
      </p>
    </section>
  )}

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {nights.map((n) => <GameCard game={n} paused={paused} />)}
  </div>
</PortalLayout>
