---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import Alert from '../../components/portal/Alert.astro';
import SeatBadge from '../../components/portal/SeatBadge.astro';
import { readForm, requireMember } from '../../lib/access';
import { friendlyDbError } from '../../lib/errors';
import { formatGameTime, seatsLeft, type GameNightRow } from '../../lib/games';
import { onBreak, type Wellbeing } from '../../lib/wellbeing';

const access = await requireMember(Astro);
if (access instanceof Response) return access;
if (access.isHost) return Astro.redirect('/host/games');
const supabase = Astro.locals.supabase!;

let formError = '';
const form = await readForm(Astro);
if (form && form.get('action') === 'request') {
  const id = String(form.get('id') ?? '');
  const { error } = await supabase.rpc('request_seat', { p_id: id, p_note: null });
  if (error) formError = friendlyDbError(error);
  else return Astro.redirect(`/games/${encodeURIComponent(id)}?notice=requested`, 303);
}

const { data: wbData } = await supabase.rpc('get_my_wellbeing');
const wellbeing = (wbData ?? null) as Wellbeing | null;
const pausedOnBreak = onBreak(wellbeing);
const paused = pausedOnBreak || Boolean(wellbeing?.limit_reached);
const { data, error } = await supabase.rpc('list_game_nights');
const nights = (data ?? []) as GameNightRow[];
---

<PortalLayout title="Game Nights" access={access} current="games">
  <header>
    <p class="eyebrow">Game Nights</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Upcoming games</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-silver-400">
      Ask for a seat and the host will confirm it. If the table is full, the host can add you to the waitlist,
      and you’ll move up automatically when a seat opens. The address appears on the game page on the day of the game, for confirmed players only.
    </p>
  </header>

  {paused && (
    <div class="mt-8"><Alert tone="info" title={pausedOnBreak ? 'You’re taking a break' : 'Monthly loss limit reached'}>
      {pausedOnBreak ? `Seat requests are paused until ${formatGameTime(wellbeing!.break_until!)}.` : 'You’ve reached the limit you set for this month, so seat requests are paused until next month.'}
      {' '}<a class="link" href="/account#play-safely">Your settings</a>
    </Alert></div>
  )}
  {formError && <div class="mt-8"><Alert tone="error">{formError}</Alert></div>}
  {error && <div class="mt-8"><Alert tone="error">We couldn’t load the games just now. Please refresh in a moment.</Alert></div>}

  {!error && nights.length === 0 && (
    <section class="panel mt-10 p-8 text-center sm:p-12">
      <p class="text-4xl text-steel-400" aria-hidden="true">♠</p>
      <h2 class="mt-4 text-3xl">No games scheduled yet.</h2>
      <p class="mx-auto mt-4 max-w-md text-silver-300">
        When the host opens the next game night it’ll appear here.
        <a class="link" href="/account#notifications">Get an email</a> when it does.
      </p>
    </section>
  )}

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {nights.map((n) => {
      const left = seatsLeft(n);
      const canRequest = !paused && n.status === 'open' && (!n.my_status || n.my_status === 'cancelled') && new Date(n.starts_at) > new Date();
      return (
        <article class:list={['panel flex flex-col p-6 sm:p-8', n.status === 'cancelled' && 'opacity-70']}>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="eyebrow">{n.stakes} · {n.game_type}</p>
              <h2 class="mt-3 text-2xl sm:text-3xl"><a href={`/games/${n.game_night_id}`} class="hover:text-steel-300">{formatGameTime(n.starts_at)}</a></h2>
            </div>
            <SeatBadge status={n.my_status} position={n.my_waitlist_position} />
          </div>
          <p class="mt-4 text-sm text-silver-300">
            {n.status === 'cancelled' ? 'This game has been cancelled.'
              : left > 0 ? `${left} of ${n.seats} seats open`
              : `Table full${n.waitlist_count ? ` · ${n.waitlist_count} on the waitlist` : ''}`}
            {n.status === 'closed' && ' · requests closed'}
          </p>
          {n.notes && <p class="mt-2 text-sm text-silver-400">{n.notes}</p>}
          <div class="mt-6 flex flex-wrap gap-3 pt-2 sm:mt-auto">
            {canRequest && (
              <form method="post">
                <input type="hidden" name="action" value="request" />
                <input type="hidden" name="id" value={n.game_night_id} />
                <button type="submit" class="btn-primary">Request a seat</button>
              </form>
            )}
            <a href={`/games/${n.game_night_id}`} class="btn-ghost">Details</a>
          </div>
        </article>
      );
    })}
  </div>
</PortalLayout>
