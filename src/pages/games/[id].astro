---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import Alert from '../../components/portal/Alert.astro';
import SeatBadge from '../../components/portal/SeatBadge.astro';
import PlayPaused from '../../components/portal/PlayPaused.astro';
import { readForm, requireMember } from '../../lib/access';
import { friendlyDbError } from '../../lib/errors';
import { canRequest, formatGameTime, isFull, myStatus, seatsLeft, torontoDate, type NightStatus, type SeatStatus } from '../../lib/games';
import { formatDate } from '../../lib/stats';
import { field } from '../../lib/validation';
import { onBreak, type Wellbeing } from '../../lib/wellbeing';

const access = await requireMember(Astro);
if (access instanceof Response) return access;
const id = Astro.params.id ?? '';
if (access.isHost) return Astro.redirect(`/host/games/${encodeURIComponent(id)}`);
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response(null, { status: 404 });
const supabase = Astro.locals.supabase!;

let formError = '';
const form = await readForm(Astro);
if (form) {
  const action = form.get('action');
  if (action === 'request') {
    const { data, error } = await supabase.rpc('request_seat', { p_id: id, p_note: field(form, 'note', 200) || null });
    if (error) formError = friendlyDbError(error);
    else return Astro.redirect(`/games/${id}?notice=${data === 'waitlisted' ? 'waitlisted' : 'requested'}`, 303);
  }
  if (action === 'cancel') {
    if (form.get('confirm_cancel') !== 'yes') formError = 'Please tick the box to confirm you’re giving up your spot.';
    else {
      const { error } = await supabase.rpc('cancel_my_seat', { p_id: id });
      if (error) formError = friendlyDbError(error);
      else return Astro.redirect(`/games/${id}?notice=cancelled`, 303);
    }
  }
}

interface Night {
  id: string; starts_at: string; game_type: string; stakes: string; seats: number; notes: string | null;
  status: NightStatus; confirmed_count: number; waitlist_count: number; my_status: SeatStatus | null;
  my_note: string | null; my_waitlist_position: number | null; address_date: string;
  attendees: Array<{ label: string; is_me: boolean; is_guest: boolean }>;
  address?: string; arrival_note?: string | null;
}
const [{ data, error }, { data: wb }] = await Promise.all([
  supabase.rpc('get_game_night', { p_id: id }),
  supabase.rpc('get_my_wellbeing'),
]);
if (error && /game_night_not_found|invalid input syntax/.test(error.message)) return new Response(null, { status: 404 });
const n = data as Night | null;
const wellbeing = (wb ?? null) as Wellbeing | null;
const paused = onBreak(wellbeing) || Boolean(wellbeing?.limit_reached);

const notices: Record<string, string> = {
  requested: 'Request sent. Your seat isn’t confirmed yet: the host will confirm it, and we’ll email you when they do (if seat updates are on).',
  waitlisted: 'The game is full, so you’re on the waitlist. You’ll see your place below, and we’ll email you if you get a seat.',
  cancelled: 'You’ve given up your spot. Thanks for letting us know.',
};
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];
const started = n ? new Date(n.starts_at) <= new Date() : false;
const active = n?.my_status === 'requested' || n?.my_status === 'confirmed' || n?.my_status === 'waitlisted';
const offer = n ? !paused && canRequest(n) : false;
const full = n ? isFull(n) : false;
const isGameDay = n ? torontoDate(new Date()) >= n.address_date : false;
const mine = n ? myStatus(n.status, n.my_status) : null;
---

<PortalLayout title="Game" access={access} current="games">
  <a href="/" class="text-sm text-silver-400 hover:text-silver-100">← Upcoming games</a>
  {notice && <div class="mt-5" role="status"><Alert tone="success">{notice}</Alert></div>}
  {formError && <div class="mt-5" role="alert"><Alert tone="error">{formError}</Alert></div>}
  {error && !n && <div class="mt-5"><Alert tone="error">We couldn’t load this game just now. Please refresh in a moment.</Alert></div>}

  {n && (
    <>
      <header class="mt-5">
        <h1 class="text-3xl leading-tight sm:text-5xl">{formatGameTime(n.starts_at)}</h1>
        <p class="mt-2 text-silver-300">{n.stakes} · {n.game_type}</p>
      </header>

      {n.status === 'cancelled' && <div class="mt-6"><Alert tone="error">This game has been cancelled by the host.</Alert></div>}
      {!active && <PlayPaused wellbeing={wellbeing} />}

      <section class="panel mt-6 p-5 sm:p-8" aria-labelledby="seat-title">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="seat-title" class="text-2xl">Your seat</h2>
          <SeatBadge status={mine} position={n.my_waitlist_position} />
        </div>

        <dl class="mt-4 grid grid-cols-3 gap-2 rounded-xl border border-silver-100/10 p-3 text-center text-sm">
          <div><dt class="text-xs text-silver-400">Confirmed</dt><dd class="mt-1 text-lg tabular-nums text-silver-50">{n.confirmed_count}/{n.seats}</dd></div>
          <div><dt class="text-xs text-silver-400">Open seats</dt><dd class="mt-1 text-lg tabular-nums text-silver-50">{seatsLeft(n)}</dd></div>
          <div><dt class="text-xs text-silver-400">Waitlist</dt><dd class="mt-1 text-lg tabular-nums text-silver-50">{n.waitlist_count}</dd></div>
        </dl>

        <p class="mt-4 leading-relaxed text-silver-200">
          {mine === 'confirmed' && 'Your seat is confirmed. See you at the table.'}
          {mine === 'completed' && 'You played this game.'}
          {mine === 'requested' && 'You’ve asked for a seat. It isn’t confirmed until the host confirms it.'}
          {mine === 'waitlisted' && `You’re number ${n.my_waitlist_position} on the waitlist. You don’t have a seat yet; we’ll email you if one opens up for you.`}
          {mine === 'declined' && 'The host wasn’t able to offer you a seat this time. We hope to see you at a future game.'}
          {(!mine || mine === 'cancelled') && offer && (full ? 'This game is full. You can join the waitlist.' : 'Seats are open. Request one and the host will confirm it.')}
          {(!mine || mine === 'cancelled') && !offer && n.status !== 'cancelled' && !paused && 'Seat requests for this game are closed.'}
        </p>
        {n.my_note && active && <p class="mt-2 text-sm text-silver-400">Your note to the host: “{n.my_note}”</p>}

        {offer && (
          <form method="post" class="mt-5 grid gap-4" novalidate>
            <input type="hidden" name="action" value="request" />
            <label class="grid gap-2">
              <span class="label !mb-0">Note for the host (optional)</span>
              <input name="note" maxlength="200" class="input" placeholder="e.g. Might be 15 minutes late" />
            </label>
            <div><button type="submit" class="btn-primary w-full sm:w-auto">{full ? 'Join waitlist' : 'Request a seat'}</button></div>
          </form>
        )}

        {active && !started && n.status !== 'cancelled' && (
          <form method="post" class="mt-6 border-t border-silver-100/10 pt-5" novalidate>
            <input type="hidden" name="action" value="cancel" />
            <label class="flex items-start gap-3 text-sm text-silver-200">
              <input type="checkbox" name="confirm_cancel" value="yes" class="mt-1 size-4 accent-[#d3707f]" />
              I can’t make it. Give my {n.my_status === 'confirmed' ? 'seat' : 'spot'} to someone else.
            </label>
            <button type="submit" class="btn-ghost mt-4">{n.my_status === 'confirmed' ? 'Cancel my seat' : n.my_status === 'waitlisted' ? 'Leave the waitlist' : 'Withdraw my request'}</button>
          </form>
        )}
      </section>

      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <section class="panel p-5 sm:p-8" aria-labelledby="who-title">
          <h2 id="who-title" class="text-2xl">Who’s playing</h2>
          {n.attendees.length === 0 ? (
            <p class="mt-3 text-sm text-silver-400">No confirmed players yet.</p>
          ) : (
            <ul class="mt-4 flex flex-wrap gap-2">
              {n.attendees.map((a) => (
                <li class:list={['rounded-full px-3 py-1.5 text-sm ring-1', a.is_me ? 'bg-[#5f8ad3]/20 text-silver-50 ring-[#5f8ad3]/50' : 'bg-silver-100/5 text-silver-200 ring-silver-100/15']}>
                  {a.label}{a.is_me && <span class="text-silver-400"> (you)</span>}
                </li>
              ))}
            </ul>
          )}
          <p class="mt-4 text-xs text-silver-500">For privacy, other players are shown by first initial, and guests as Guest 1, Guest 2…</p>
        </section>

        <section class="panel p-5 sm:p-8" aria-labelledby="where-title">
          <h2 id="where-title" class="text-2xl">Where</h2>
          {n.address ? (
            <div class="mt-3">
              <p class="text-lg text-silver-50">{n.address}</p>
              {n.arrival_note && <p class="mt-2 text-sm text-silver-300">{n.arrival_note}</p>}
              <p class="mt-3 text-xs text-silver-500">Please keep the address private.</p>
            </div>
          ) : (
            <p class="mt-3 text-sm leading-relaxed text-silver-300">
              {n.my_status === 'confirmed'
                ? isGameDay ? 'The address isn’t available right now.' : `The address appears here on ${formatDate(n.address_date)}, the day of the game.`
                : 'London, Ontario. The address is shared with confirmed players on the day of the game.'}
            </p>
          )}
          {n.notes && (
            <>
              <h3 class="label mt-6">From the host</h3>
              <p class="text-sm leading-relaxed text-silver-300">{n.notes}</p>
            </>
          )}
        </section>
      </div>
    </>
  )}
</PortalLayout>
