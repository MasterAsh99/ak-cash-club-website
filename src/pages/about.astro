---
/**
 * About the Club: everything secondary, in one compact page of expandable
 * sections. PRIVACY: never add the address, player names, phone numbers or
 * financial details here. This page is public.
 */
import PortalLayout from '../layouts/PortalLayout.astro';
import { gameDetails, instagramUrl, links, site } from '../config/site';

const sections = [
  { id: 'games', title: 'Our games' },
  { id: 'equipment', title: 'Equipment & setup' },
  { id: 'food', title: 'Food & drinks' },
  { id: 'promotions', title: 'Promotions & jackpots' },
  { id: 'club', title: 'Club information' },
  { id: 'contact', title: 'Contact' },
];
---

<PortalLayout
  title="About the Club"
  description="About AK Cash Club: the game, the equipment, food and drinks, promotions and how to join."
  current="about"
  indexable
>
  <div class="mx-auto max-w-2xl">
    <p class="eyebrow">About the Club</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">A private game, hosted properly.</h1>
    <p class="mt-4 leading-relaxed text-silver-300">
      AK Cash Club is a private No-Limit Texas Hold’em cash game held in a home in {site.city}. It’s a smaller,
      more personal game: every player is confirmed in advance, and the address is shared only with players who have a seat.
    </p>
    <div class="mt-6 grid grid-cols-2 gap-3">
      <a href="/signup?next=/games" class="btn-primary">Sign up</a>
      <a href="/games" class="btn-ghost">Upcoming games</a>
    </div>

    <div class="mt-10 divide-y divide-silver-100/10 rounded-2xl border border-silver-100/10 bg-midnight-900/50">
      {sections.map((s, i) => (
        <details id={s.id} class="group scroll-mt-24" open={i === 0}>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 text-lg text-silver-50 sm:px-6 [&::-webkit-details-marker]:hidden">
            {s.title}
            <span class="text-silver-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="space-y-3 px-5 pb-6 text-sm leading-relaxed text-silver-300 sm:px-6">
            {s.id === 'games' && (
              <>
                <p><strong class="text-silver-100">No-Limit Texas Hold’em, as a cash game.</strong> Every bet is yours to size, up to the stack in front of you. The chips represent real money; there’s no elimination and no rising blinds, and you can leave whenever you choose.</p>
                <p><strong class="text-silver-100">Low-to-medium stakes.</strong> Comfortable for newer players, and still worth sitting down for if you’ve played for years. Each game’s stakes are shown in Upcoming Games.</p>
                <p><strong class="text-silver-100">How to join a game.</strong> Create an account, open Upcoming Games and request a seat. The host confirms seats; if a game is full you can join its waitlist.</p>
              </>
            )}
            {s.id === 'equipment' && (
              <>
                <p><strong class="text-silver-100">The table:</strong> a full-size Manhattan-style poker table with solid box legs and blue felt, hand-built in Toronto by <a class="link" href={links.manhattanTable} target="_blank" rel="noopener">Straight Poker Supplies</a>.</p>
                <p><strong class="text-silver-100">The cards:</strong> <a class="link" href={links.kemCards} target="_blank" rel="noopener">KEM poker-size cards</a>, 100% plastic. The same brand you’ll find in casino poker rooms and at the World Series of Poker.</p>
              </>
            )}
            {s.id === 'food' && (
              <>
                <p>Food and non-alcoholic drinks are complimentary for every player. There’s nothing to bring and nothing to pay for.</p>
                <p><strong class="text-silver-100">Alcohol:</strong> our hosts don’t serve alcohol under any circumstances. You’re welcome to bring your own (BYOB).</p>
              </>
            )}
            {s.id === 'promotions' && (
              <>
                <p><strong class="text-silver-100">High hands:</strong> make a qualifying hand and you’re paid a bonus on top of the pot.</p>
                <p><strong class="text-silver-100">Jackpots:</strong> a larger prize for a rarer hand or moment at the table.</p>
                <p>Qualifying hands and amounts change from game to game and are posted on <a class="link" href={instagramUrl} target="_blank" rel="noopener">@{site.instagramHandle}</a>.</p>
              </>
            )}
            {s.id === 'club' && (
              <dl class="divide-y divide-silver-100/10">
                {gameDetails.map((d) => (
                  <div class="grid grid-cols-[7rem_1fr] gap-3 py-2.5">
                    <dt class="text-xs tracking-[0.14em] text-silver-400 uppercase">{d.label}</dt>
                    <dd class="text-silver-100">{d.value}{'note' in d && d.note && <span class="block text-xs text-silver-400">{d.note}</span>}</dd>
                  </div>
                ))}
              </dl>
            )}
            {s.id === 'contact' && (
              <>
                <p>Questions about the game or the stakes? Message us on Instagram at <a class="link" href={instagramUrl} target="_blank" rel="noopener">@{site.instagramHandle}</a>.</p>
                <p>To play, request a seat from <a class="link" href="/games">Upcoming Games</a>. You don’t need Instagram to join a game.</p>
              </>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</PortalLayout>
