---
/**
 * Home. Rendered per visit so it can show the right thing:
 *   - Signed out: what the club is, and Sign up / Log in, above the fold.
 *   - Signed in:  your games, upcoming games with Request / Join waitlist,
 *                 and the host's announcement.
 */
export const prerender = false;

import PortalLayout from '../layouts/PortalLayout.astro';
import Alert from '../components/portal/Alert.astro';
import GameCard from '../components/portal/GameCard.astro';
import PlayPaused from '../components/portal/PlayPaused.astro';
import SeatBadge from '../components/portal/SeatBadge.astro';
import Logo from '../components/Logo.astro';
import { loadAccess } from '../lib/access';
import { formatGameTime, myStatus, type GameNightRow } from '../lib/games';
import { onBreak, type Wellbeing } from '../lib/wellbeing';
import { site } from '../config/site';

// Emailed links that fell back to the home page go to the confirmation page.
const q = Astro.url.searchParams;
if (q.has('code') || q.has('error_code') || q.has('token_hash')) return Astro.redirect(`/auth/confirm${Astro.url.search}`);

const access = Astro.locals.user ? await loadAccess(Astro) : null;
const supabase = Astro.locals.supabase;

let nights: GameNightRow[] = [];
let wellbeing: Wellbeing | null = null;
let announcement: string | null = null;
let loadError = false;
type HostRow = { game_night_id: string; starts_at: string; stakes: string; seats: number; status: string; requested_count: number; confirmed_count: number; waitlist_count: number };
let hostGames: HostRow[] = [];

if (access && supabase) {
  const [ann, games, wb] = await Promise.all([
    supabase.rpc('get_announcement'),
    access.isHost ? supabase.rpc('host_list_game_nights', { p_include_past: false }) : supabase.rpc('list_game_nights'),
    access.isHost ? Promise.resolve({ data: null }) : supabase.rpc('get_my_wellbeing'),
  ]);
  announcement = (ann.data as string | null) ?? null;
  loadError = Boolean(games.error);
  if (access.isHost) hostGames = (games.data ?? []) as HostRow[];
  else nights = (games.data ?? []) as GameNightRow[];
  wellbeing = (wb.data ?? null) as Wellbeing | null;
}
const notice = Astro.url.searchParams.get('notice') === 'verified' ? 'Your email is verified. Welcome to AK Cash Club.' : '';
const paused = onBreak(wellbeing) || Boolean(wellbeing?.limit_reached);
const mine = nights.filter((n) => ['requested', 'confirmed', 'waitlisted'].includes(n.my_status ?? '') && n.status !== 'cancelled');
const waiting = hostGames.reduce((s, g) => s + (g.status === 'cancelled' ? 0 : g.requested_count), 0);
---

<PortalLayout
  title="Home"
  fullTitle={`${site.name} · Private Poker · ${site.city}`}
  description="AK Cash Club is a private No-Limit Texas Hold’em game in London, Ontario. Members see upcoming games, request a seat, and can track their results."
  access={access}
  current="home"
  indexable
>
  {!access ? (
    <>
      <!-- Signed out: the next step is obvious and above the fold on a phone. -->
      <section class="mx-auto max-w-xl pt-2 text-center sm:pt-8" aria-labelledby="home-title">
        <Logo size="lg" showWordmark={false} priority class="[&_img]:size-20 sm:[&_img]:size-24" />
        <p class="eyebrow mt-5">Private poker · {site.city}</p>
        <h1 id="home-title" class="mt-3 text-[clamp(2.4rem,10vw,3.75rem)] leading-[1.02]"><span class="text-metal">AK Cash Club</span></h1>
        <p class="mx-auto mt-4 max-w-md leading-relaxed text-silver-300">
          Create an account or log in to view upcoming games, request a seat, and track your poker results.
        </p>
        <div class="mt-7 grid grid-cols-2 gap-3">
          <a href="/signup?next=/games" class="btn-primary">Sign up</a>
          <a href="/login?next=/games" class="btn-ghost">Log in</a>
        </div>
        <p class="mt-3 text-xs text-silver-500">Free. No payments are taken on this website.</p>
      </section>

      <section class="mx-auto mt-12 max-w-3xl" aria-labelledby="how-title">
        <h2 id="how-title" class="sr-only">How it works</h2>
        <ol class="grid gap-3 sm:grid-cols-3">
          {[
            ['Create an account', 'Takes a minute. Just an email, a username and a password.'],
            ['Request a seat', 'Pick an upcoming game. The host confirms your seat, or you join the waitlist.'],
            ['Track your results', 'Optional and private to you. Turn it on whenever you like.'],
          ].map(([t, b], i) => (
            <li class="rounded-2xl border border-silver-100/10 p-5">
              <p class="text-xs font-medium tracking-[0.2em] text-steel-300">STEP {i + 1}</p>
              <h3 class="mt-1 text-xl text-silver-50">{t}</h3>
              <p class="mt-1 text-sm leading-relaxed text-silver-400">{b}</p>
            </li>
          ))}
        </ol>
        <p class="mt-6 text-center text-sm text-silver-400">
          No-Limit Texas Hold’em cash game · Manhattan-style table · KEM cards · complimentary food and non-alcoholic drinks.
          <a class="link ml-1 whitespace-nowrap" href="/about">About the Club →</a>
        </p>
      </section>
    </>
  ) : access.isHost ? (
    <>
      <h1 class="text-3xl sm:text-4xl">Welcome back, host.</h1>
      {announcement && <div class="mt-6"><Alert tone="info" title="Announcement">{announcement}</Alert></div>}
      <a href="/host" class="panel mt-6 flex items-center justify-between gap-4 p-5 transition hover:border-steel-300/40 sm:p-6">
        <span>
          <span class="block text-xl text-silver-50">Host dashboard</span>
          <span class="text-sm text-silver-400">{waiting ? `${waiting} seat request${waiting === 1 ? '' : 's'} waiting` : 'Games, players, waitlists and results'}</span>
        </span>
        <span class="text-steel-300" aria-hidden="true">→</span>
      </a>
      <h2 class="mt-10 text-2xl">Upcoming games</h2>
      {hostGames.length === 0 && <p class="mt-3 text-sm text-silver-400">No upcoming games. <a class="link" href="/host/games/new">Create one</a>.</p>}
      <ul class="mt-4 grid gap-3">
        {hostGames.map((g) => (
          <li>
            <a href={`/host/games/${g.game_night_id}`} class="panel flex flex-wrap items-center justify-between gap-3 p-4 transition hover:border-steel-300/40 sm:p-5">
              <span>
                <span class="block text-lg text-silver-50">{formatGameTime(g.starts_at)}</span>
                <span class="text-sm text-silver-400">{g.stakes} · {g.confirmed_count}/{g.seats} confirmed · {g.waitlist_count} waitlisted{g.status === 'cancelled' ? ' · cancelled' : ''}</span>
              </span>
              {g.requested_count > 0 && g.status !== 'cancelled' && <span class="rounded-full bg-[#d9b25f]/10 px-3 py-1 text-xs text-[#eedcae] ring-1 ring-[#d9b25f]/35">{g.requested_count} to review</span>}
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <>
      <h1 class="text-3xl sm:text-4xl">Hi, {access.username}.</h1>
      {notice && <div class="mt-6" role="status"><Alert tone="success">{notice}</Alert></div>}
      {announcement && <div class="mt-6"><Alert tone="info" title="From the host">{announcement}</Alert></div>}
      <PlayPaused wellbeing={wellbeing} />
      {loadError && <div class="mt-6"><Alert tone="error">We couldn’t load the games just now. Please refresh in a moment.</Alert></div>}

      {mine.length > 0 && (
        <section class="mt-8" aria-labelledby="mine-title">
          <h2 id="mine-title" class="text-2xl">My games</h2>
          <ul class="mt-3 grid gap-2">
            {mine.map((n) => (
              <li>
                <a href={`/games/${n.game_night_id}`} class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-silver-100/10 bg-midnight-900/60 p-4 transition hover:border-steel-300/40">
                  <span>
                    <span class="block text-silver-50">{formatGameTime(n.starts_at, 'short')}</span>
                    <span class="text-xs text-silver-400">{n.stakes}</span>
                  </span>
                  <SeatBadge status={myStatus(n.status, n.my_status)} position={n.my_waitlist_position} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-8" aria-labelledby="upcoming-title">
        <h2 id="upcoming-title" class="text-2xl">Upcoming games</h2>
        {!loadError && nights.length === 0 && (
          <p class="mt-3 rounded-2xl border border-silver-100/10 p-5 text-sm text-silver-300">
            No games scheduled yet. They’ll appear here as soon as the host opens one.
            <a class="link" href="/account#notifications">Get an email</a> when that happens.
          </p>
        )}
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          {nights.map((n) => <GameCard game={n} paused={paused} showNotes={false} />)}
        </div>
      </section>

      <p class="mt-10 text-sm text-silver-400">
        Results from AK Cash Club games are on <a class="link" href="/dashboard">My Dashboard</a> (if tracking is on).
      </p>
    </>
  )}
</PortalLayout>
