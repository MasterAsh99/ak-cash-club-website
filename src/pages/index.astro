---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Game from '../components/Game.astro';
import Equipment from '../components/Equipment.astro';
import Hospitality from '../components/Hospitality.astro';
import Promotions from '../components/Promotions.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Game />
    <Equipment />
    <Hospitality />
    <Promotions />
    <Contact />
  </main>
  <Footer />
  <script is:inline>
    // If an emailed link falls back to the home page (Supabase uses the Site URL
    // when a redirect isn't allow-listed), send it to the confirmation page.
    (function () {
      var q = new URLSearchParams(location.search);
      if (q.has('code') || q.has('error_code') || q.has('token_hash')) location.replace('/auth/confirm' + location.search);
    })();
  </script>
</BaseLayout>
