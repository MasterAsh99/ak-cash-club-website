---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import HostNav from '../../../components/portal/HostNav.astro';
import Alert from '../../../components/portal/Alert.astro';
import Field from '../../../components/portal/Field.astro';
import ExpenseForm from '../../../components/portal/ExpenseForm.astro';
import { readForm, requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { parseExpense, readExpenseValues, type ExpenseRow, type ExpenseValues } from '../../../lib/expenses';
import { centsToInput, formatCents, toCents } from '../../../lib/money';
import { formatDate } from '../../../lib/stats';
import { field } from '../../../lib/validation';

const access = await requireHost(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;

const id = Astro.params.id ?? '';
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) return new Response(null, { status: 404 });

const { data } = await supabase.rpc('host_list_expenses', { p_from: null, p_to: null, p_session_id: null, p_limit: 2000 });
const row = ((data ?? []) as ExpenseRow[]).find((r) => r.expense_id === id);
if (!row) return new Response(null, { status: 404 });

type SessionOpt = { session_id: string; played_on: string; title: string | null; stakes: string };
const { data: sessionData } = await supabase.rpc('host_list_sessions', { p_limit: 200, p_offset: 0 });
const sessions = (sessionData ?? []) as SessionOpt[];
const sessionIds = new Set(sessions.map((s) => s.session_id));

let values: ExpenseValues = {
  id,
  spent_on: String(row.spent_on).slice(0, 10),
  category: row.category,
  description: row.description,
  amount: centsToInput(toCents(row.amount_cents)),
  session_id: row.session_id ?? '',
  reason: '',
};
let errors: Record<string, string> = {};
let formError = '';
const deleteErrors: Record<string, string> = {};
let deleteError = '';

const form = await readForm(Astro);
if (form) {
  if (field(form, 'intent', 10) === 'delete') {
    const reason = field(form, 'delete_reason', 200);
    if (reason.length < 3) deleteErrors.delete_reason = 'Give a short reason (it goes in the audit log).';
    if (form.get('confirm_delete') !== 'yes') deleteErrors.confirm = 'Tick the box to confirm.';
    if (!Object.keys(deleteErrors).length) {
      const { error } = await supabase.rpc('host_delete_expense', { p_expense_id: id, p_reason: reason });
      if (error) deleteError = friendlyDbError(error);
      else return Astro.redirect('/host/expenses?notice=deleted', 303);
    }
  } else {
    values = { ...readExpenseValues(form), id };
    const parsed = parseExpense(values, { isEdit: true, sessionIds });
    if (!parsed.ok) errors = parsed.errors;
    else {
      const { error } = await supabase.rpc('host_save_expense', { p_expense: parsed.payload, p_reason: values.reason });
      if (error) formError = friendlyDbError(error);
      else return Astro.redirect('/host/expenses?notice=updated', 303);
    }
  }
}
---

<PortalLayout title="Edit expense" access={access} current="host">
  <HostNav current="expenses">
    <h1 class="mt-3 text-4xl sm:text-5xl">{formatCents(toCents(row.amount_cents))}</h1>
    <p class="mt-2 text-silver-300">{row.description} · {formatDate(String(row.spent_on))}</p>
  </HostNav>

  <section class="panel mt-10 p-5 sm:p-8" aria-labelledby="edit-title">
    <h2 id="edit-title" class="text-2xl">Edit expense</h2>
    <div class="mt-6">
      <ExpenseForm values={values} errors={errors} sessions={sessions} isEdit={true} formError={formError} />
    </div>
  </section>

  <section class="panel mt-4 p-5 sm:p-8" aria-labelledby="delete-title">
    <h2 id="delete-title" class="text-2xl">Delete expense</h2>
    <form method="post" class="mt-5 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end" novalidate>
      <input type="hidden" name="intent" value="delete" />
      {deleteError && <div class="sm:col-span-2"><Alert tone="error">{deleteError}</Alert></div>}
      <Field label="Reason" name="delete_reason" maxlength={200} placeholder="e.g. Entered twice" error={deleteErrors.delete_reason} />
      <button type="submit" class="btn-danger">Delete expense</button>
      <label class="flex items-start gap-3 text-sm text-silver-200 sm:col-span-2">
        <input type="checkbox" name="confirm_delete" value="yes" class="mt-1 size-4 accent-[#d3707f]" />
        Delete this expense.
      </label>
      {deleteErrors.confirm && <p class="field-error sm:col-span-2">{deleteErrors.confirm}</p>}
    </form>
  </section>

  <p class="mt-8"><a class="link text-sm" href="/host/expenses">← All expenses</a></p>
</PortalLayout>
