---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import HostNav from '../../../components/portal/HostNav.astro';
import Alert from '../../../components/portal/Alert.astro';
import StatTile from '../../../components/portal/StatTile.astro';
import ExpenseForm from '../../../components/portal/ExpenseForm.astro';
import { readForm, requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { categoryLabel, parseExpense, readExpenseValues, summarize, type ExpenseRow, type ExpenseValues } from '../../../lib/expenses';
import { formatCents, toCents } from '../../../lib/money';
import { formatDate } from '../../../lib/stats';

const access = await requireHost(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;

const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto' }).format(new Date());
const thisYear = today.slice(0, 4);
const yearParam = Astro.url.searchParams.get('year') ?? thisYear;
const year = yearParam === 'all' ? 'all' : /^\d{4}$/.test(yearParam) ? yearParam : thisYear;

type SessionOpt = { session_id: string; played_on: string; title: string | null; stakes: string };
const { data: sessionData } = await supabase.rpc('host_list_sessions', { p_limit: 200, p_offset: 0 });
const sessions = (sessionData ?? []) as SessionOpt[];
const sessionIds = new Set(sessions.map((s) => s.session_id));

const prefillSession = Astro.url.searchParams.get('session') ?? '';
let values: ExpenseValues = {
  id: '', spent_on: today, category: '', description: '', amount: '',
  session_id: sessionIds.has(prefillSession) ? prefillSession : '', reason: '',
};
let errors: Record<string, string> = {};
let formError = '';

const form = await readForm(Astro);
if (form) {
  values = readExpenseValues(form);
  values.id = '';
  const parsed = parseExpense(values, { isEdit: false, sessionIds });
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    const { error } = await supabase.rpc('host_save_expense', { p_expense: parsed.payload, p_reason: null });
    if (error) formError = friendlyDbError(error);
    else return Astro.redirect(`/host/expenses?year=${year}&notice=added`, 303);
  }
}

const { data, error } = await supabase.rpc('host_list_expenses', {
  p_from: year === 'all' ? null : `${year}-01-01`,
  p_to: year === 'all' ? null : `${year}-12-31`,
  p_session_id: null,
  p_limit: 2000,
});
const rows = (data ?? []) as ExpenseRow[];
const summary = summarize(rows);
const years = Array.from(new Set([thisYear, ...sessions.map((s) => String(s.played_on).slice(0, 4))])).sort().reverse();

const notices: Record<string, string> = {
  added: 'Expense added.',
  updated: 'Expense updated and recorded in the audit log.',
  deleted: 'Expense deleted. The audit log keeps a record of it.',
};
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];
const periodLabel = year === 'all' ? 'all time' : year;
---

<PortalLayout title="Expenses" access={access} current="host">
  <HostNav current="expenses">
    <h1 class="mt-3 text-4xl sm:text-5xl">Expenses</h1>
    <p class="mt-2 max-w-xl text-sm text-silver-400">
      What you spend on hosting, like food, non-alcoholic drinks, cards and equipment. Only you can see this.
    </p>
  </HostNav>

  {notice && <div class="mt-8"><Alert tone="success">{notice}</Alert></div>}
  {error && <div class="mt-8"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}

  <nav aria-label="Period" class="mt-8 flex flex-wrap gap-2 text-sm">
    {[...years, 'all'].map((y) => (
      <a
        href={`/host/expenses?year=${y}`}
        aria-current={y === year ? 'page' : undefined}
        class:list={['inline-flex min-h-9 items-center rounded-full px-4 transition', y === year ? 'bg-steel-500/20 text-silver-50 ring-1 ring-steel-400/40' : 'border border-silver-100/15 text-silver-300 hover:border-steel-300/50']}
      >
        {y === 'all' ? 'All time' : y}
      </a>
    ))}
  </nav>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <div class="col-span-2 lg:col-span-1"><StatTile label={`Total spent · ${periodLabel}`} value={formatCents(summary.total)} large /></div>
    <StatTile label="Expenses recorded" value={String(summary.count)} />
    <StatTile label="Average per game" value={summary.averagePerGame === null ? '—' : formatCents(summary.averagePerGame)} detail={`Across ${summary.byGame.length} game${summary.byGame.length === 1 ? '' : 's'}`} />
    <StatTile label="Not linked to a game" value={formatCents(summary.unlinkedTotal)} detail="Equipment, supplies, etc." />
  </div>

  <section id="add" class="panel mt-4 scroll-mt-28 p-5 sm:p-8" aria-labelledby="add-title">
    <h2 id="add-title" class="text-2xl">Add an expense</h2>
    <div class="mt-6">
      <ExpenseForm values={values} errors={errors} sessions={sessions} isEdit={false} formError={formError} />
    </div>
  </section>

  {summary.count > 0 && (
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <section class="panel overflow-hidden" aria-labelledby="cat-title">
        <h2 id="cat-title" class="px-5 pt-6 text-2xl sm:px-8">By category</h2>
        <table class="mt-4 w-full text-left text-sm tabular-nums">
          <tbody class="divide-y divide-silver-100/10 border-t border-silver-100/10">
            {summary.byCategory.map((c) => (
              <tr>
                <th scope="row" class="px-5 py-3 font-normal text-silver-100 sm:px-8">{c.label} <span class="text-xs text-silver-500">· {c.count}</span></th>
                <td class="px-5 py-3 text-right text-silver-100 sm:px-8">{formatCents(c.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
      <section class="panel overflow-hidden" aria-labelledby="game-title">
        <h2 id="game-title" class="px-5 pt-6 text-2xl sm:px-8">By game</h2>
        {summary.byGame.length === 0 ? (
          <p class="px-5 py-6 text-sm text-silver-400 sm:px-8">No expenses are linked to a game in this period.</p>
        ) : (
          <table class="mt-4 w-full text-left text-sm tabular-nums">
            <tbody class="divide-y divide-silver-100/10 border-t border-silver-100/10">
              {summary.byGame.map((g) => (
                <tr>
                  <th scope="row" class="px-5 py-3 font-normal sm:px-8">
                    <a class="link" href={`/host/sessions/${g.sessionId}`}>{formatDate(g.playedOn)}</a>
                    <span class="text-xs text-silver-500"> {g.title ?? ''} {g.stakes ? `· ${g.stakes}` : ''}</span>
                  </th>
                  <td class="px-5 py-3 text-right text-silver-100 sm:px-8">{formatCents(g.total)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    </div>
  )}

  <section class="panel mt-4 overflow-hidden" aria-labelledby="list-title">
    <h2 id="list-title" class="px-5 pt-6 text-2xl sm:px-8">All expenses · {periodLabel}</h2>
    {rows.length === 0 ? (
      <p class="px-5 py-8 text-silver-400 sm:px-8">No expenses recorded for {periodLabel} yet.</p>
    ) : (
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm tabular-nums">
          <thead>
            <tr class="border-y border-silver-100/10 text-[0.68rem] tracking-[0.16em] text-silver-400 uppercase">
              <th scope="col" class="px-5 py-3 font-medium sm:px-8">Date</th>
              <th scope="col" class="px-3 py-3 font-medium">What</th>
              <th scope="col" class="px-3 py-3 font-medium">Game</th>
              <th scope="col" class="px-5 py-3 text-right font-medium sm:px-8">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-silver-100/10">
            {rows.map((r) => (
              <tr>
                <th scope="row" class="px-5 py-3 font-normal sm:px-8"><a class="link" href={`/host/expenses/${r.expense_id}`}>{formatDate(String(r.spent_on))}</a></th>
                <td class="px-3 py-3 text-silver-200">{r.description} <span class="block text-xs text-silver-500">{categoryLabel(r.category)}</span></td>
                <td class="px-3 py-3 text-silver-400">{r.session_id ? formatDate(String(r.session_played_on)) : '—'}</td>
                <td class="px-5 py-3 text-right text-silver-100 sm:px-8">{formatCents(toCents(r.amount_cents))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</PortalLayout>
