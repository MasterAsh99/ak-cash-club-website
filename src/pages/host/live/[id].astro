---
/**
 * Live game-night mode (host only). Built for a phone at the table: check
 * players in, record buy-ins/rebuys with how they paid, record cash-outs,
 * then finalize into a recorded session.
 */
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import Alert from '../../../components/portal/Alert.astro';
import { readForm, requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { formatGameTime } from '../../../lib/games';
import { displayName, liveTotals, playerTotals, type LiveGame } from '../../../lib/live';
import { centsToJson, formatCents, parseDollars } from '../../../lib/money';
import { field } from '../../../lib/validation';

const access = await requireHost(Astro);
if (access instanceof Response) return access;
const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response(null, { status: 404 });
const supabase = Astro.locals.supabase!;
const back = (anchor = '', notice = '') => Astro.redirect(`/host/live/${id}${notice ? `?notice=${notice}` : ''}${anchor ? `#${anchor}` : ''}`, 303);

let actionError = '';
let errorFor = '';
const form = await readForm(Astro);
if (form) {
  const action = field(form, 'action', 30);
  const lp = field(form, 'lp', 36);
  const run = async (fn: string, args: Record<string, unknown>) => {
    const { data, error } = await supabase.rpc(fn, args);
    if (error) { actionError = friendlyDbError(error); errorFor = lp; }
    return error ? null : (data ?? true);
  };

  if (action === 'start' && (await run('host_live_start', { p_game_night_id: id }))) return back();
  if (action === 'buyin') {
    const amount = parseDollars(field(form, 'amount', 20));
    const method = form.get('method') === 'etransfer' ? 'etransfer' : 'cash';
    if (!amount.ok || amount.cents <= 0n) { actionError = amount.ok ? 'Enter an amount above $0.' : amount.error; errorFor = lp; }
    else if (await run('host_live_buy_in', { p_live_player_id: lp, p_amount_cents: centsToJson(amount.cents), p_method: method })) return back(`p-${lp}`);
  }
  if (action === 'undo' && (await run('host_live_undo_buy_in', { p_buyin_id: field(form, 'buyin', 36) }))) return back(`p-${lp}`);
  if (action === 'cashout') {
    const amount = parseDollars(field(form, 'amount', 20));
    const method = form.get('method') === 'etransfer' ? 'etransfer' : 'cash';
    if (!amount.ok) { actionError = amount.error; errorFor = lp; }
    else if (await run('host_live_cash_out', { p_live_player_id: lp, p_amount_cents: centsToJson(amount.cents), p_method: method })) return back(`p-${lp}`);
  }
  if (action === 'clear_cashout' && (await run('host_live_cash_out', { p_live_player_id: lp, p_amount_cents: null, p_method: null }))) return back(`p-${lp}`);
  if (action === 'checkin' && (await run('host_live_check_in', { p_live_player_id: lp, p_checked_in: form.get('value') === 'on' }))) return back(`p-${lp}`);
  if (action === 'remove' && (await run('host_live_remove_player', { p_live_player_id: lp }))) return back('players');
  if (action === 'add_member') {
    const pid = field(form, 'player_id', 36);
    if (!pid) actionError = 'Choose a member to add.';
    else if (await run('host_live_add_player', { p_game_night_id: id, p_player_id: pid, p_guest_label: null })) return back('players');
  }
  if (action === 'add_guest') {
    const label = field(form, 'guest_label', 40);
    if (!label) actionError = 'Enter a name for the guest.';
    else if (await run('host_live_add_player', { p_game_night_id: id, p_player_id: null, p_guest_label: label })) return back('players');
  }
  if (action === 'finalize') {
    if (form.get('confirm') !== 'yes') actionError = 'Tick the box to confirm the cash-outs are final.';
    else {
      const sessionId = await run('host_live_finalize', { p_game_night_id: id });
      if (sessionId) return Astro.redirect(`/host/sessions/${sessionId}?notice=created#payments`, 303);
    }
  }
}

const { data, error } = await supabase.rpc('host_live_get', { p_game_night_id: id });
const g = data as LiveGame | null;
type NightInfo = { starts_at: string; stakes: string; status: string };
const nightRes = g ? null : await supabase.rpc('host_get_game_night', { p_id: id });
if (nightRes?.error && /game_night_not_found/.test(nightRes.error.message)) return new Response(null, { status: 404 });
const night = (nightRes?.data ?? null) as NightInfo | null;
const totals = g ? liveTotals(g.players) : null;
const finalized = Boolean(g?.finalized_at);

let members: Array<{ player_id: string; username: string; tracking_enabled: boolean }> = [];
if (g && !finalized) {
  const { data: m } = await supabase.rpc('host_list_players', { p_query: null, p_limit: 200 });
  const inGame = new Set(g.players.map((p) => p.player_id).filter(Boolean));
  members = ((m ?? []) as typeof members).filter((x) => !inGame.has(x.player_id));
}
const methodLabel = { cash: 'Cash', etransfer: 'e-Transfer' } as const;
---

<PortalLayout title="Live game" access={access} current="host">
  <a href={`/host/games/${id}`} class="text-sm text-silver-400 hover:text-silver-100">← Game night</a>
  <header class="mt-4">
    <p class="eyebrow">Live game{finalized ? ' · finalized' : ''}</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">{formatGameTime((g ?? night)?.starts_at ?? new Date().toISOString(), 'short')}</h1>
    <p class="mt-1 text-sm text-silver-400">{(g ?? night)?.stakes}</p>
  </header>

  {actionError && !errorFor && <div class="mt-6" role="alert"><Alert tone="error">{actionError}</Alert></div>}
  {error && <div class="mt-6"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}

  {!g && night && (
    <section class="panel mt-8 p-6 text-center sm:p-10">
      <h2 class="text-2xl">Ready when you are</h2>
      <p class="mx-auto mt-3 max-w-md text-sm text-silver-300">Players with a confirmed seat will be listed. Check them in as they arrive, and add walk-ins as needed.</p>
      {night.status === 'cancelled' ? <p class="mt-6 text-silver-400">This game night is cancelled.</p> : (
        <form method="post" class="mt-6"><input type="hidden" name="action" value="start" /><button type="submit" class="btn-primary">Start live game</button></form>
      )}
    </section>
  )}

  {g && totals && (
    <>
      {finalized && (
        <div class="mt-6"><Alert tone="success">This game was finalized and recorded. <a class="link" href={`/host/sessions/${g.finalized_session_id}`}>Open the session</a>.</Alert></div>
      )}

      <section aria-label="Totals" class="sticky top-[7.5rem] z-10 mt-6 grid grid-cols-3 gap-2 rounded-2xl border border-silver-100/10 bg-midnight-950/90 p-3 text-center backdrop-blur sm:top-32 sm:p-4">
        <div><p class="label !mb-1 text-[0.62rem]">Bought in</p><p class="tabular-nums text-silver-50">{formatCents(totals.buyIns)}</p></div>
        <div><p class="label !mb-1 text-[0.62rem]">Cashed out</p><p class="tabular-nums text-silver-50">{formatCents(totals.cashOuts)}</p></div>
        <div><p class="label !mb-1 text-[0.62rem]">{totals.stillPlaying ? 'In play' : 'Difference'}</p><p class:list={['tabular-nums', !totals.stillPlaying && totals.inPlay !== 0n ? 'text-[#ecc0c7]' : 'text-silver-50']}>{formatCents(totals.inPlay)}</p></div>
      </section>
      <p class="mt-2 px-1 text-xs text-silver-500">
        Cash in {formatCents(totals.cashIn)} · out {formatCents(totals.cashOut)} · e-Transfer in {formatCents(totals.etransferIn)} · out {formatCents(totals.etransferOut)} · {totals.checkedIn} checked in
      </p>

      <section id="players" class="mt-6 grid scroll-mt-48 gap-3" aria-label="Players">
        {g.players.length === 0 && <p class="panel p-6 text-silver-400">No players yet. Add them below.</p>}
        {g.players.map((p) => {
          const t = playerTotals(p);
          return (
            <article id={`p-${p.id}`} class:list={['panel scroll-mt-48 p-4 sm:p-6', !p.checked_in_at && 'opacity-80']}>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <h2 class="text-xl text-silver-50">{displayName(p)}</h2>
                  {!p.player_id && <span class="font-sans text-xs text-silver-500">Guest</span>}
                  {p.player_id && !p.tracking_enabled && <span class="font-sans text-xs text-silver-500">Not tracking, so recorded as a guest</span>}
                </div>
                <p class="text-sm tabular-nums text-silver-300">
                  In {formatCents(t.buyIn)}{t.cashOut !== null && <> · Out {formatCents(t.cashOut)} · <span class={t.net! >= 0n ? 'text-[#bcd0f2]' : 'text-[#ecc0c7]'}>{formatCents(t.net!, { signed: true })}</span></>}
                </p>
              </div>
              {errorFor === p.id && actionError && <p class="field-error mt-2" role="alert">{actionError}</p>}

              {p.buyins.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2 text-xs">
                  {p.buyins.map((b) => (
                    <li class="inline-flex items-center gap-1 rounded-full bg-silver-100/5 py-1 pr-1 pl-3 text-silver-200 ring-1 ring-silver-100/15">
                      {formatCents(BigInt(String(b.amount_cents)))} · {methodLabel[b.method]}
                      {!finalized && t.cashOut === null && (
                        <form method="post" class="inline">
                          <input type="hidden" name="action" value="undo" /><input type="hidden" name="lp" value={p.id} /><input type="hidden" name="buyin" value={b.id} />
                          <button type="submit" class="rounded-full px-2 text-silver-400 hover:text-silver-50" aria-label={`Undo ${formatCents(BigInt(String(b.amount_cents)))} buy-in`}>✕</button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              )}

              {!finalized && (
                t.cashOut === null ? (
                  <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    <form method="post" class="grid grid-cols-2 items-end gap-2">
                      <input type="hidden" name="action" value="buyin" /><input type="hidden" name="lp" value={p.id} />
                      <label class="col-span-2"><span class="label">{p.buyins.length ? 'Rebuy' : 'Buy-in'} $</span>
                        <input name="amount" inputmode="decimal" autocomplete="off" class="input" placeholder={p.buyins.length ? String(Number(BigInt(String(p.buyins.at(-1)!.amount_cents)) / 100n)) : '200'} /></label>
                      <button type="submit" name="method" value="cash" class="btn-primary min-h-11 w-full px-4 text-sm">Cash</button>
                      <button type="submit" name="method" value="etransfer" class="btn-ghost min-h-11 w-full px-4 text-sm">e-Transfer</button>
                    </form>
                    {p.buyins.length > 0 ? (
                      <form method="post" class="grid grid-cols-2 items-end gap-2">
                        <input type="hidden" name="action" value="cashout" /><input type="hidden" name="lp" value={p.id} />
                        <label class="col-span-2"><span class="label">Cash-out $</span>
                          <input name="amount" inputmode="decimal" autocomplete="off" class="input" placeholder="0" /></label>
                        <button type="submit" name="method" value="cash" class="btn-ghost min-h-11 w-full px-4 text-sm">Paid cash</button>
                        <button type="submit" name="method" value="etransfer" class="btn-ghost min-h-11 w-full px-4 text-sm">e-Transfer</button>
                      </form>
                    ) : (
                      <div class="flex flex-wrap items-end gap-2">
                        <form method="post"><input type="hidden" name="action" value="checkin" /><input type="hidden" name="lp" value={p.id} /><input type="hidden" name="value" value={p.checked_in_at ? 'off' : 'on'} />
                          <button type="submit" class="btn-ghost min-h-11 px-4 text-sm">{p.checked_in_at ? 'Undo check-in' : 'Check in'}</button></form>
                        <form method="post"><input type="hidden" name="action" value="remove" /><input type="hidden" name="lp" value={p.id} />
                          <button type="submit" class="min-h-11 px-3 text-sm text-silver-400 hover:text-silver-100">Remove</button></form>
                      </div>
                    )}
                  </div>
                ) : (
                  <form method="post" class="mt-3">
                    <input type="hidden" name="action" value="clear_cashout" /><input type="hidden" name="lp" value={p.id} />
                    <p class="text-sm text-silver-300">Cashed out {formatCents(t.cashOut)} by {methodLabel[p.payout_method ?? 'cash']}. <button type="submit" class="link">Change</button></p>
                  </form>
                )
              )}
            </article>
          );
        })}
      </section>

      {!finalized && (
        <>
          <section class="panel mt-4 grid gap-6 p-5 sm:grid-cols-2 sm:p-8" aria-label="Add a player">
            <form method="post" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="action" value="add_member" />
              <label class="min-w-40 flex-1"><span class="label">Add a member</span>
                <select name="player_id" class="input">
                  <option value="">Choose…</option>
                  {members.map((m) => <option value={m.player_id}>{m.username}{m.tracking_enabled ? '' : ' (not tracking)'}</option>)}
                </select></label>
              <button type="submit" class="btn-ghost min-h-11 px-4 text-sm">Add</button>
            </form>
            <form method="post" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="action" value="add_guest" />
              <label class="min-w-40 flex-1"><span class="label">Add a guest</span>
                <input name="guest_label" maxlength="40" class="input" placeholder="e.g. Sam (friend of Bob)" autocomplete="off" /></label>
              <button type="submit" class="btn-ghost min-h-11 px-4 text-sm">Add</button>
            </form>
          </section>

          <section class="panel mt-4 p-5 sm:p-8" aria-labelledby="fin-title">
            <h2 id="fin-title" class="text-2xl">Finish and record</h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-silver-300">
              Creates the session with everyone’s buy-ins, rebuys and cash-outs, and fills in how each player paid and was paid.
              Members with tracking on see their result on their dashboard; everyone else is recorded as a guest.
              {totals.stillPlaying > 0 && ` ${totals.stillPlaying} player${totals.stillPlaying === 1 ? ' is' : 's are'} still to cash out.`}
              {totals.stillPlaying === 0 && totals.inPlay !== 0n && ` Cash-outs differ from buy-ins by ${formatCents(totals.inPlay)}. You can explain it with an adjustment on the session afterwards.`}
            </p>
            <form method="post" class="mt-5" novalidate>
              <input type="hidden" name="action" value="finalize" />
              <label class="flex items-start gap-3 text-sm text-silver-200">
                <input type="checkbox" name="confirm" value="yes" class="mt-1 size-4 accent-[#5f8ad3]" />
                The cash-outs are final. Record this game.
              </label>
              <button type="submit" class="btn-primary mt-4" disabled={totals.stillPlaying > 0 || totals.buyIns === 0n}>Finalize game</button>
            </form>
          </section>
        </>
      )}
    </>
  )}
</PortalLayout>
