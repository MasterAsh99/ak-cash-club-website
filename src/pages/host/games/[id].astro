---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import HostNav from '../../../components/portal/HostNav.astro';
import Alert from '../../../components/portal/Alert.astro';
import SeatBadge from '../../../components/portal/SeatBadge.astro';
import GameNightFormView from '../../../components/portal/GameNightForm.astro';
import { readForm, requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { formatGameTime, parseGameNightForm, type GameNightForm, type NightStatus, type SeatStatus } from '../../../lib/games';

const access = await requireHost(Astro);
if (access instanceof Response) return access;
const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response(null, { status: 404 });
const supabase = Astro.locals.supabase!;

let errors: Record<string, string> = {};
let formError = '';
let actionError = '';
let posted: GameNightForm | null = null;

const form = await readForm(Astro);
if (form) {
  const action = form.get('action');
  if (action === 'decide') {
    const status = String(form.get('status') ?? '');
    const { error } = await supabase.rpc('host_decide_seat', { p_request_id: String(form.get('request_id') ?? ''), p_status: status });
    if (error) actionError = friendlyDbError(error);
    else return Astro.redirect(`/host/games/${id}?notice=${status}#requests`, 303);
  }
  if (action === 'save') {
    const parsed = parseGameNightForm(form);
    posted = parsed.values;
    errors = parsed.errors;
    if (!Object.keys(errors).length) {
      const { error } = await supabase.rpc('host_save_game_night', { p_game_night: { ...parsed.values, id, announce: false } });
      if (error) formError = friendlyDbError(error);
      else return Astro.redirect(`/host/games/${id}?notice=saved`, 303);
    }
  }
  if (action === 'cancel_game') {
    if (form.get('confirm') !== 'yes') actionError = 'Tick the box to confirm cancelling this game.';
    else {
      const { error } = await supabase.rpc('host_cancel_game_night', { p_id: id });
      if (error) actionError = friendlyDbError(error);
      else return Astro.redirect(`/host/games/${id}?notice=game-cancelled`, 303);
    }
  }
}

interface Req { id: string; username: string; status: SeatStatus; note: string | null; queued_at: string }
interface Night {
  id: string; starts_at: string; starts_local: string; game_type: string; stakes: string; seats: number;
  notes: string | null; status: NightStatus; address: string | null; arrival_note: string | null; requests: Req[];
}
const { data, error } = await supabase.rpc('host_get_game_night', { p_id: id });
if (error && /game_night_not_found/.test(error.message)) return new Response(null, { status: 404 });
const n = data as Night | null;

const values: GameNightForm | null = posted ?? (n ? {
  starts_local: n.starts_local, game_type: n.game_type === 'No-Limit Texas Hold\'em' ? '' : n.game_type,
  stakes: n.stakes, seats: n.seats, notes: n.notes ?? '', address: n.address ?? '', arrival_note: n.arrival_note ?? '',
  status: n.status === 'closed' ? 'closed' : 'open', announce: false,
} : null);

const notices: Record<string, string> = {
  created: 'Game night opened. Members can now request seats.',
  saved: 'Changes saved.',
  confirmed: 'Seat confirmed. The player will be emailed (if they have seat updates on).',
  waitlisted: 'Added to the waitlist. They’ll move up automatically if a seat opens.',
  declined: 'Request declined.',
  'game-cancelled': 'Game cancelled. Everyone with a seat or request will be emailed.',
};
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];
const groups = n ? {
  requested: n.requests.filter((r) => r.status === 'requested'),
  confirmed: n.requests.filter((r) => r.status === 'confirmed'),
  waitlisted: n.requests.filter((r) => r.status === 'waitlisted'),
  other: n.requests.filter((r) => r.status === 'declined' || r.status === 'cancelled'),
} : null;
const full = n && groups ? groups.confirmed.length >= n.seats : false;
const editable = n?.status !== 'cancelled';
---

<PortalLayout title="Game night" access={access} current="host">
  <HostNav current="games">
    <h1 class="mt-3 text-3xl sm:text-4xl">{n ? formatGameTime(n.starts_at) : 'Game night'}</h1>
    {n && <p class="mt-2 text-sm text-silver-400">{n.stakes} · {n.game_type} · {groups!.confirmed.length}/{n.seats} confirmed</p>}
  </HostNav>

  {notice && <div class="mt-8"><Alert tone="success">{notice}</Alert></div>}
  {actionError && <div class="mt-8"><Alert tone="error">{actionError}</Alert></div>}
  {error && !n && <div class="mt-8"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}
  {n?.status === 'cancelled' && <div class="mt-8"><Alert tone="error">This game night is cancelled.</Alert></div>}

  {n && groups && (
    <>
      <section id="requests" class="panel mt-8 scroll-mt-28 overflow-hidden" aria-labelledby="req-title">
        <h2 id="req-title" class="px-5 pt-6 text-2xl sm:px-8">Seats</h2>
        {n.requests.length === 0 ? (
          <p class="px-5 py-8 text-silver-400 sm:px-8">No requests yet.</p>
        ) : (
          <ul class="mt-4 divide-y divide-silver-100/10 border-t border-silver-100/10">
            {[...groups.requested, ...groups.confirmed, ...groups.waitlisted, ...groups.other].map((r) => (
              <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8">
                <div class="min-w-0">
                  <p class="flex flex-wrap items-center gap-3">
                    <span class="text-silver-50">{r.username}</span>
                    <SeatBadge status={r.status} position={r.status === 'waitlisted' ? groups.waitlisted.indexOf(r) + 1 : null} />
                  </p>
                  {r.note && <p class="mt-1 text-sm text-silver-400">“{r.note}”</p>}
                </div>
                {editable && r.status !== 'cancelled' && (
                  <form method="post" class="flex flex-wrap gap-2">
                    <input type="hidden" name="action" value="decide" />
                    <input type="hidden" name="request_id" value={r.id} />
                    {r.status !== 'confirmed' && (
                      <button type="submit" name="status" value="confirmed" class="btn-primary min-h-10 px-4 text-sm" disabled={full}>Confirm</button>
                    )}
                    {r.status !== 'waitlisted' && (
                      <button type="submit" name="status" value="waitlisted" class="btn-ghost min-h-10 px-4 text-sm">Waitlist</button>
                    )}
                    {r.status !== 'declined' && (
                      <button type="submit" name="status" value="declined" class="btn-ghost min-h-10 px-4 text-sm">Decline</button>
                    )}
                  </form>
                )}
              </li>
            ))}
          </ul>
        )}
        {full && groups.requested.length > 0 && editable && (
          <p class="border-t border-silver-100/10 px-5 py-4 text-sm text-silver-400 sm:px-8">The table is full. Waitlist new requests, or add a seat below.</p>
        )}
      </section>

      {editable && values && (
        <section class="panel mt-4 p-5 sm:p-8" aria-labelledby="edit-title">
          <details open={Object.keys(errors).length > 0 || !!formError}>
            <summary class="cursor-pointer text-2xl" id="edit-title">Edit game night</summary>
            <div class="mt-6"><GameNightFormView values={values} errors={errors} isEdit formError={formError} /></div>
          </details>
        </section>
      )}

      {editable && (
        <section class="panel mt-4 border-[#d3707f]/25 p-5 sm:p-8" aria-labelledby="cancel-title">
          <h2 id="cancel-title" class="text-2xl">Cancel this game</h2>
          <form method="post" class="mt-4" novalidate>
            <input type="hidden" name="action" value="cancel_game" />
            <label class="flex items-start gap-3 text-sm text-silver-200">
              <input type="checkbox" name="confirm" value="yes" class="mt-1 size-4 accent-[#d3707f]" />
              Cancel the game and email everyone with a seat or request.
            </label>
            <button type="submit" class="btn-danger mt-4">Cancel game night</button>
          </form>
        </section>
      )}
    </>
  )}
</PortalLayout>
