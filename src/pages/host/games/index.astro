---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import HostNav from '../../../components/portal/HostNav.astro';
import Alert from '../../../components/portal/Alert.astro';
import GameNightFormView from '../../../components/portal/GameNightForm.astro';
import { readForm, requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { formatGameTime, parseGameNightForm, torontoDate, type GameNightForm, type NightStatus } from '../../../lib/games';

const access = await requireHost(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;

const showPast = Astro.url.searchParams.get('past') === '1';
const tomorrow = torontoDate(new Date(Date.now() + 86_400_000));
const { data: last } = await supabase.rpc('host_last_venue');
let values: GameNightForm = {
  starts_local: `${tomorrow}T19:00`, game_type: '', stakes: '', seats: 8, notes: '',
  address: (last as { address?: string } | null)?.address ?? '',
  arrival_note: (last as { arrival_note?: string } | null)?.arrival_note ?? '',
  status: 'open', announce: true,
};
let errors: Record<string, string> = {};
let formError = '';

const form = await readForm(Astro);
if (form && form.get('action') === 'save') {
  const parsed = parseGameNightForm(form);
  values = parsed.values;
  errors = parsed.errors;
  if (!Object.keys(errors).length) {
    const { data, error } = await supabase.rpc('host_save_game_night', { p_game_night: values });
    if (error) formError = friendlyDbError(error);
    else return Astro.redirect(`/host/games/${data}?notice=created`, 303);
  }
}

type Row = { game_night_id: string; starts_at: string; stakes: string; seats: number; status: NightStatus;
             requested_count: number; confirmed_count: number; waitlist_count: number };
const { data, error } = await supabase.rpc('host_list_game_nights', { p_include_past: showPast });
const rows = (data ?? []) as Row[];
const now = new Date();
---

<PortalLayout title="Game nights" access={access} current="host">
  <HostNav current="games">
    <h1 class="mt-3 text-4xl sm:text-5xl">Game nights</h1>
    <p class="mt-2 max-w-xl text-sm text-silver-400">Open a game, then confirm seat requests with one tap.</p>
  </HostNav>

  {error && <div class="mt-8"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}

  <section class="panel mt-8 overflow-hidden" aria-labelledby="list-title">
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-6 sm:px-8">
      <h2 id="list-title" class="text-2xl">{showPast ? 'All game nights' : 'Upcoming'}</h2>
      <a class="link text-sm" href={showPast ? '/host/games' : '/host/games?past=1'}>{showPast ? 'Upcoming only' : 'Show past games'}</a>
    </div>
    {rows.length === 0 ? (
      <p class="px-5 py-8 text-silver-400 sm:px-8">No game nights yet. Open one below.</p>
    ) : (
      <ul class="mt-4 divide-y divide-silver-100/10 border-t border-silver-100/10">
        {rows.map((r) => (
          <li>
            <a href={`/host/games/${r.game_night_id}`} class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 transition hover:bg-silver-100/[0.03] sm:px-8">
              <span>
                <span class="block text-silver-50">{formatGameTime(r.starts_at)}</span>
                <span class="text-xs text-silver-400">
                  {r.stakes} · {r.confirmed_count}/{r.seats} confirmed
                  {r.waitlist_count > 0 && ` · ${r.waitlist_count} waitlisted`}
                  {r.status === 'cancelled' ? ' · cancelled' : r.status === 'closed' ? ' · requests closed' : ''}
                  {new Date(r.starts_at) < now && r.status !== 'cancelled' ? ' · past' : ''}
                </span>
              </span>
              {r.requested_count > 0 && r.status !== 'cancelled' && (
                <span class="rounded-full bg-[#5f8ad3]/15 px-3 py-1 text-xs font-medium text-[#bcd0f2] ring-1 ring-[#5f8ad3]/40">
                  {r.requested_count} new request{r.requested_count === 1 ? '' : 's'}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="new" class="panel mt-4 scroll-mt-28 p-5 sm:p-8" aria-labelledby="new-title">
    <h2 id="new-title" class="text-2xl">Open a new game night</h2>
    <div class="mt-6"><GameNightFormView values={values} errors={errors} isEdit={false} formError={formError} /></div>
  </section>
</PortalLayout>
