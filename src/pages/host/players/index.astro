---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import HostNav from '../../../components/portal/HostNav.astro';
import Alert from '../../../components/portal/Alert.astro';
import { requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { formatDate } from '../../../lib/stats';

const access = await requireHost(Astro);
if (access instanceof Response) return access;

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 40);
const { data, error } = await Astro.locals.supabase!.rpc('host_list_players', { p_query: q || null, p_limit: 200 });
type Player = { player_id: string; username: string; tracking_enabled: boolean; tracking_consented_at: string | null; joined_at: string; sessions_tracked: number };
const players = (data ?? []) as Player[];
const trackedCount = players.filter((p) => p.tracking_enabled).length;
---

<PortalLayout title="Players" access={access} current="host">
  <HostNav current="players">
    <h1 class="mt-3 text-4xl sm:text-5xl">Players</h1>
  </HostNav>

  <form method="get" class="mt-10 flex flex-col gap-3 sm:flex-row" role="search">
    <label for="q" class="sr-only">Search by username</label>
    <input id="q" name="q" class="input sm:max-w-sm" placeholder="Search by username" value={q} maxlength="40" />
    <button class="btn-ghost" type="submit">Search</button>
  </form>

  {error && <div class="mt-6"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}

  <p class="mt-6 text-sm text-silver-400">
    {players.length} player{players.length === 1 ? '' : 's'}{q && ` matching “${q}”`} · {trackedCount} with tracking on.
    Only players with tracking on can have results linked to their account.
  </p>

  <section class="panel mt-4 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <caption class="sr-only">Registered players</caption>
        <thead>
          <tr class="border-b border-silver-100/10 text-[0.68rem] tracking-[0.16em] text-silver-400 uppercase">
            <th scope="col" class="px-5 py-4 font-medium sm:px-8">Username</th>
            <th scope="col" class="px-3 py-4 font-medium">Tracking</th>
            <th scope="col" class="px-3 py-4 text-right font-medium">Sessions</th>
            <th scope="col" class="px-5 py-4 text-right font-medium sm:px-8">Joined</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-silver-100/10">
          {players.map((p) => (
            <tr>
              <th scope="row" class="px-5 py-4 font-normal sm:px-8">
                <a class="link" href={`/host/players/${p.player_id}`}>{p.username}</a>
              </th>
              <td class="px-3 py-4">
                {p.tracking_enabled ? (
                  <span class="text-silver-100">● On <span class="text-xs text-silver-400">since {formatDate(p.tracking_consented_at!.slice(0, 10))}</span></span>
                ) : (
                  <span class="text-silver-500">○ Off</span>
                )}
              </td>
              <td class="px-3 py-4 text-right tabular-nums text-silver-300">{p.sessions_tracked}</td>
              <td class="px-5 py-4 text-right text-silver-400 sm:px-8">{formatDate(p.joined_at.slice(0, 10))}</td>
            </tr>
          ))}
          {players.length === 0 && (
            <tr><td colspan="4" class="px-8 py-10 text-center text-silver-400">No players found.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </section>
</PortalLayout>
