---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import HostNav from '../../../components/portal/HostNav.astro';
import Alert from '../../../components/portal/Alert.astro';
import StatTile from '../../../components/portal/StatTile.astro';
import { requireHost } from '../../../lib/access';
import { friendlyDbError } from '../../../lib/errors';
import { formatCents } from '../../../lib/money';
import { computeStats, formatDate, type ResultRow } from '../../../lib/stats';

const access = await requireHost(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;

const id = Astro.params.id ?? '';
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) return new Response(null, { status: 404 });

const { data: playerRows } = await supabase.rpc('host_list_players', { p_query: null, p_limit: 200 });
const player = ((playerRows ?? []) as Array<{ player_id: string; username: string; tracking_enabled: boolean }>).find((p) => p.player_id === id);
if (!player) return new Response(null, { status: 404 });

const { data, error } = await supabase.rpc('host_get_player_results', { p_player_id: id });
const stats = computeStats((data ?? []) as ResultRow[], 50);
const tone = (c: bigint) => (c > 0n ? 'gain' : c < 0n ? 'loss' : 'neutral') as 'gain' | 'loss' | 'neutral';
---

<PortalLayout title={player.username} access={access} current="host">
  <HostNav current="players">
    <h1 class="mt-3 text-4xl sm:text-5xl">{player.username}</h1>
    <p class="mt-2 text-sm text-silver-400">Tracking {player.tracking_enabled ? 'on' : 'off'} · amounts in CAD</p>
  </HostNav>

  {error && <div class="mt-8"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}
  {!player.tracking_enabled && stats.sessions > 0 && (
    <div class="mt-8"><Alert tone="info">This player has turned tracking off. Their results are hidden from their dashboard, and no new results can be linked to them.</Alert></div>
  )}

  {stats.sessions === 0 ? (
    <section class="panel mt-10 p-10 text-center text-silver-300">No results linked to this player yet.</section>
  ) : (
    <>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <StatTile label="Lifetime result" value={formatCents(stats.lifetimeNet, { signed: true })} tone={tone(stats.lifetimeNet)} />
        <StatTile label="Sessions" value={String(stats.sessions)} />
        <StatTile label="Total buy-ins" value={formatCents(stats.totalBuyIns)} />
        <StatTile label="Total cash-outs" value={formatCents(stats.totalCashOuts)} />
      </div>
      <section class="panel mt-4 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[32rem] text-left text-sm tabular-nums">
            <caption class="sr-only">Results for {player.username}</caption>
            <thead>
              <tr class="border-b border-silver-100/10 text-[0.68rem] tracking-[0.16em] text-silver-400 uppercase">
                <th scope="col" class="px-5 py-4 font-medium sm:px-8">Date</th>
                <th scope="col" class="px-3 py-4 text-right font-medium">Buy-ins</th>
                <th scope="col" class="px-3 py-4 text-right font-medium">Cash-out</th>
                <th scope="col" class="px-5 py-4 text-right font-medium sm:px-8">Net</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-silver-100/10">
              {stats.recent.map((r) => (
                <tr>
                  <th scope="row" class="px-5 py-4 font-normal sm:px-8"><a class="link" href={`/host/sessions/${r.sessionId}`}>{formatDate(r.playedOn)}</a> <span class="text-xs text-silver-500">{r.stakes}</span></th>
                  <td class="px-3 py-4 text-right text-silver-300">{formatCents(r.buyIn)}</td>
                  <td class="px-3 py-4 text-right text-silver-300">{formatCents(r.cashOut)}</td>
                  <td class:list={['px-5 py-4 text-right font-medium sm:px-8', tone(r.net) === 'neutral' ? 'text-silver-100' : tone(r.net)]}>{formatCents(r.net, { signed: true })}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</PortalLayout>
