---
export const prerender = false;

import PortalLayout from '../layouts/PortalLayout.astro';
import AuthCard from '../components/portal/AuthCard.astro';
import Field from '../components/portal/Field.astro';
import Alert from '../components/portal/Alert.astro';
import NotConfigured from '../components/portal/NotConfigured.astro';
import { readForm } from '../lib/access';
import { siteUrl } from '../lib/env';
import { allowAuthAttempt, RATE_LIMITED_MESSAGE } from '../lib/ratelimit';
import { field, isEmail } from '../lib/validation';

const supabase = Astro.locals.supabase;
let email = '';
let formError = '';

const form = await readForm(Astro);
if (form && supabase) {
  email = field(form, 'email', 254).toLowerCase();
  if (!isEmail(email)) {
    formError = 'Please enter a valid email address.';
  } else if (!(await allowAuthAttempt(Astro.request, 'reset', email))) {
    formError = RATE_LIMITED_MESSAGE;
  } else {
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${siteUrl(Astro.url)}/auth/confirm`,
    });
    if (error) console.error('reset request failed', error.code);
    // Identical outcome whether or not the account exists.
    return Astro.redirect('/check-email?for=reset');
  }
}
---

<PortalLayout title="Reset your password" current="auth" width="narrow">
  <AuthCard eyebrow="Members" title="Reset your password">
    {!supabase ? (
      <NotConfigured />
    ) : (
      <form method="post" class="space-y-6" novalidate>
        <p class="leading-relaxed text-silver-300">
          Enter the email address you signed up with. If it belongs to an account, we’ll send a secure,
          single-use link to choose a new password.
        </p>
        {formError && <Alert tone="error">{formError}</Alert>}
        <Field label="Email" name="email" type="email" autocomplete="email" required value={email} />
        <button type="submit" class="btn-primary w-full">Send reset link</button>
      </form>
    )}
    <p slot="after"><a class="link" href="/login">Back to log in</a></p>
  </AuthCard>
</PortalLayout>
