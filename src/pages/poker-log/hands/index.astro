---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import Alert from '../../../components/portal/Alert.astro';
import PokerTabs from '../../../components/portal/PokerTabs.astro';
import HandForm from '../../../components/portal/HandForm.astro';
import PlayingCard from '../../../components/portal/PlayingCard.astro';
import { readForm, requireMember } from '../../../lib/access';
import { readHandForm, validateHand, type HandValues } from '../../../lib/cards';
import { friendlyDbError } from '../../../lib/errors';
import { formatDate } from '../../../lib/stats';

const access = await requireMember(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto' }).format(new Date());

let values: HandValues = { id: '', played_on: today, title: '', stakes: '', position: '', hole: ['', ''], board: ['', '', '', '', ''], notes: '' };
let errors: Record<string, string> = {};
let formError = '';
const form = await readForm(Astro);
if (form) {
  values = { ...readHandForm(form), id: '' };
  const v = validateHand(values);
  if (!v.ok) errors = v.errors;
  else {
    const { error } = await supabase.rpc('my_hand_save', { p_hand: v.payload });
    if (error) formError = friendlyDbError(error);
    else return Astro.redirect('/poker-log/hands?notice=saved', 303);
  }
}

type Hand = { hand_id: string; played_on: string; title: string; stakes: string | null; position: string | null; hole_cards: string[]; board: string[]; notes: string | null };
const { data, error } = await supabase.rpc('my_hands_list');
const hands = (data ?? []) as Hand[];
const notices: Record<string, string> = { saved: 'Hand saved.', updated: 'Hand updated.', deleted: 'Hand deleted.' };
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];
---

<PortalLayout title="Hand notes" access={access} current="log">
  <header>
    <p class="eyebrow">My Poker Log</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Hand notes</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-silver-300">
      Write down the hands worth thinking about: your cards, the board and what happened. Only you can see these.
    </p>
  </header>
  <PokerTabs current="hands" />

  {notice && <div class="mt-6"><Alert tone="success">{notice}</Alert></div>}
  {error && <div class="mt-6"><Alert tone="error">{friendlyDbError(error)}</Alert></div>}

  <section id="add" class="panel mt-6 scroll-mt-28 p-5 sm:p-8" aria-labelledby="add-title">
    <h2 id="add-title" class="text-2xl">{hands.length ? 'Add a hand' : 'Add your first hand'}</h2>
    <div class="mt-6"><HandForm values={values} errors={errors} isEdit={false} formError={formError} /></div>
  </section>

  {hands.length > 0 && (
    <section class="mt-4 grid gap-3" aria-label="Your hands">
      {hands.map((h) => (
        <a href={`/poker-log/hands/${h.hand_id}`} class="panel block p-5 transition hover:border-steel-300/40 sm:p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="text-xl text-silver-50">{h.title}</h2>
              <p class="mt-1 text-xs text-silver-400">{formatDate(String(h.played_on))}{h.stakes && ` · ${h.stakes}`}{h.position && ` · ${h.position}`}</p>
            </div>
            {(h.hole_cards.length > 0 || h.board.length > 0) && (
              <div class="flex flex-wrap items-center gap-1.5">
                {h.hole_cards.map((c) => <PlayingCard code={c} size="sm" />)}
                {h.hole_cards.length > 0 && h.board.length > 0 && <span class="mx-1 text-silver-500" aria-hidden="true">|</span>}
                {h.board.map((c) => <PlayingCard code={c} size="sm" />)}
              </div>
            )}
          </div>
          {h.notes && <p class="mt-3 line-clamp-2 text-sm text-silver-300">{h.notes}</p>}
        </a>
      ))}
    </section>
  )}
</PortalLayout>
