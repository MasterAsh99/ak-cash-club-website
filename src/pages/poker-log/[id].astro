---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import Alert from '../../components/portal/Alert.astro';
import LogForm from '../../components/portal/LogForm.astro';
import { readForm, requireMember } from '../../lib/access';
import { friendlyDbError } from '../../lib/errors';
import { centsToInput, formatCents, toCents } from '../../lib/money';
import { AK_WARNING, minutesToInput, parseLogEntry, readLogValues, type LogRow, type LogValues } from '../../lib/poker-log';
import { formatDate } from '../../lib/stats';
import { field } from '../../lib/validation';

const access = await requireMember(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;

const id = Astro.params.id ?? '';
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) return new Response(null, { status: 404 });
const { data } = await supabase.rpc('my_log_list');
const row = ((data ?? []) as LogRow[]).find((r) => r.entry_id === id);
if (!row) return new Response(null, { status: 404 });

let values: LogValues = {
  id,
  played_on: String(row.played_on).slice(0, 10),
  venue: row.venue,
  game: row.game,
  format: row.format,
  stakes: row.stakes ?? '',
  buy_in: centsToInput(toCents(row.buy_in_cents)),
  cash_out: centsToInput(toCents(row.cash_out_cents)),
  duration: minutesToInput(row.duration_minutes),
  notes: row.notes ?? '',
};
let errors: Record<string, string> = {};
let formError = '';
let deleteError = '';

const form = await readForm(Astro);
if (form) {
  if (field(form, 'intent', 10) === 'delete') {
    if (form.get('confirm_delete') !== 'yes') deleteError = 'Tick the box to confirm.';
    else {
      const { error } = await supabase.rpc('my_log_delete', { p_entry_id: id });
      if (error) deleteError = friendlyDbError(error);
      else return Astro.redirect('/poker-log?notice=deleted', 303);
    }
  } else {
    values = { ...readLogValues(form), id };
    const parsed = parseLogEntry(values, { isEdit: true });
    if (!parsed.ok) errors = parsed.errors;
    else {
      const { error } = await supabase.rpc('my_log_save', { p_entry: parsed.payload });
      if (error) formError = friendlyDbError(error);
      else return Astro.redirect('/poker-log?notice=updated', 303);
    }
  }
}
---

<PortalLayout title="Edit log entry" access={access} current="log">
  <header>
    <p class="eyebrow">My Poker Log</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{formatDate(String(row.played_on))} · {row.venue}</h1>
    <p class="mt-2 text-silver-300 tabular-nums">Net {formatCents(toCents(row.net_cents), { signed: true })}</p>
  </header>
  <div class="mt-8"><Alert tone="info">{AK_WARNING}</Alert></div>

  <section class="panel mt-4 p-5 sm:p-8" aria-labelledby="edit-title">
    <h2 id="edit-title" class="text-2xl">Edit entry</h2>
    <div class="mt-6"><LogForm values={values} errors={errors} isEdit={true} formError={formError} /></div>
  </section>

  <section class="panel mt-4 p-5 sm:p-8" aria-labelledby="delete-title">
    <h2 id="delete-title" class="text-2xl">Delete entry</h2>
    <form method="post" class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" novalidate>
      <input type="hidden" name="intent" value="delete" />
      <label class="flex items-start gap-3 text-sm text-silver-200">
        <input type="checkbox" name="confirm_delete" value="yes" class="mt-1 size-4 accent-[#d3707f]" />
        Delete this entry permanently.
      </label>
      <button type="submit" class="btn-danger">Delete entry</button>
    </form>
    {deleteError && <p class="field-error">{deleteError}</p>}
  </section>

  <p class="mt-8"><a class="link text-sm" href="/poker-log">← My Poker Log</a></p>
</PortalLayout>
