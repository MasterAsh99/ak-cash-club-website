---
export const prerender = false;

import PortalLayout from '../layouts/PortalLayout.astro';
import Alert from '../components/portal/Alert.astro';
import Field from '../components/portal/Field.astro';
import HostVisibility from '../components/portal/HostVisibility.astro';
import { readForm, requireMember } from '../lib/access';
import { siteUrl } from '../lib/env';
import { friendlyAuthError, friendlyDbError } from '../lib/errors';
import { allowAuthAttempt, RATE_LIMITED_MESSAGE } from '../lib/ratelimit';
import { formatDate } from '../lib/stats';
import {
  PASSWORD_HELP, USERNAME_HELP, field, isEmail, passwordProblem, rawField, usernameMessage, usernameProblem,
} from '../lib/validation';

let access = await requireMember(Astro);
if (access instanceof Response) return access;
const supabase = Astro.locals.supabase!;

type Section = 'username' | 'tracking' | 'password' | 'email' | 'delete';
const msg: Partial<Record<Section, { tone: 'success' | 'error'; text: string }>> = {};
const errors: Record<string, string> = {};

/** Confirm the person knows their current password before sensitive changes. */
async function reauthenticate(password: string): Promise<string | null> {
  if (!password) return 'Please enter your current password.';
  if (!(await allowAuthAttempt(Astro.request, 'reauth', access instanceof Response ? '' : access.email))) {
    return RATE_LIMITED_MESSAGE;
  }
  const { error } = await supabase.auth.signInWithPassword({
    email: (access as { email: string }).email,
    password,
  });
  return error ? 'Your current password is incorrect.' : null;
}

const form = await readForm(Astro);
if (form) {
  const action = field(form, 'action', 30);

  if (action === 'username' && !access.isHost) {
    const name = field(form, 'username', 40);
    const problem = usernameProblem(name);
    if (problem) {
      errors.username = usernameMessage(problem);
    } else {
      const { error } = await supabase.rpc('update_my_username', { p_username: name });
      if (error) errors.username = friendlyDbError(error);
      else msg.username = { tone: 'success', text: 'Your username has been updated.' };
    }
  }

  if (action === 'tracking_on' && !access.isHost) {
    if (form.get('consent') !== 'yes') {
      errors.consent = 'Please confirm you understand what the host can see and do.';
    } else {
      const { error } = await supabase.rpc('set_my_tracking', { p_enabled: true });
      msg.tracking = error ? { tone: 'error', text: friendlyDbError(error) } : { tone: 'success', text: 'Tracking is on. Your results will appear on your dashboard once the host records a session.' };
    }
  }

  if (action === 'tracking_off' && !access.isHost) {
    const { error } = await supabase.rpc('set_my_tracking', { p_enabled: false });
    msg.tracking = error ? { tone: 'error', text: friendlyDbError(error) } : { tone: 'success', text: 'Tracking is off. Your results are hidden and no new results can be linked to you.' };
  }

  if (action === 'unlink' && !access.isHost) {
    if (form.get('confirm_unlink') !== 'yes') {
      errors.unlink = 'Please tick the box to confirm.';
    } else {
      const { data, error } = await supabase.rpc('unlink_my_history');
      msg.tracking = error
        ? { tone: 'error', text: friendlyDbError(error) }
        : { tone: 'success', text: `Removed ${data ?? 0} session${data === 1 ? '' : 's'} from your account.` };
    }
  }

  if (action === 'password') {
    const current = rawField(form, 'current_password');
    const next = rawField(form, 'new_password');
    const confirm = rawField(form, 'confirm_password');
    const problem = passwordProblem(next, { email: access.email, username: access.username });
    if (problem) errors.new_password = problem;
    else if (next !== confirm) errors.confirm_password = 'The passwords don’t match.';
    else {
      const authProblem = await reauthenticate(current);
      if (authProblem) errors.current_password = authProblem;
      else {
        const { error } = await supabase.auth.updateUser({ password: next });
        if (error) errors.new_password = friendlyAuthError(error);
        else {
          await supabase.auth.signOut({ scope: 'others' });
          msg.password = { tone: 'success', text: 'Your password has been changed. Any other devices have been signed out.' };
        }
      }
    }
  }

  if (action === 'email') {
    const newEmail = field(form, 'new_email', 254).toLowerCase();
    const current = rawField(form, 'current_password_email');
    if (!isEmail(newEmail)) errors.new_email = 'Please enter a valid email address.';
    else if (newEmail === access.email.toLowerCase()) errors.new_email = 'That’s already your email address.';
    else {
      const authProblem = await reauthenticate(current);
      if (authProblem) errors.current_password_email = authProblem;
      else {
        const { error } = await supabase.auth.updateUser(
          { email: newEmail },
          { emailRedirectTo: `${siteUrl(Astro.url)}/auth/confirm` },
        );
        msg.email = error
          ? { tone: 'error', text: friendlyAuthError(error) }
          : { tone: 'success', text: `Check both inboxes. We’ve sent confirmation links to your current address and to ${newEmail}. The change completes once both are confirmed.` };
      }
    }
  }

  if (action === 'delete' && !access.isHost) {
    const typed = field(form, 'confirm_username', 40);
    const current = rawField(form, 'current_password_delete');
    if (typed !== access.username) errors.confirm_username = 'Type your username exactly as shown to confirm.';
    else if (form.get('confirm_delete') !== 'yes') errors.confirm_delete = 'Please tick the box to confirm.';
    else {
      const authProblem = await reauthenticate(current);
      if (authProblem) errors.current_password_delete = authProblem;
      else {
        const { error } = await supabase.rpc('delete_my_account');
        if (error) msg.delete = { tone: 'error', text: friendlyDbError(error) };
        else {
          await supabase.auth.signOut({ scope: 'local' }).catch(() => undefined);
          Astro.cookies.delete('akc_member', { path: '/' });
          return Astro.redirect('/account-deleted', 303);
        }
      }
    }
  }

  // Reload what we show after any change.
  const fresh = await requireMember(Astro);
  if (fresh instanceof Response) return fresh;
  access = fresh;
}

const notices: Record<string, { tone: 'success' | 'error'; text: string }> = {
  'email-changed': { tone: 'success', text: 'Your email address has been changed.' },
  'email-change-partial': { tone: 'success', text: 'Thanks. Now open the confirmation link sent to your other email address to finish the change.' },
};
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];
---

<PortalLayout title="Account" access={access} current="account">
  <header>
    <p class="eyebrow">Account</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Your account</h1>
  </header>
  {notice && <div class="mt-8"><Alert tone={notice.tone}>{notice.text}</Alert></div>}

  <div class="mt-10 grid gap-5">
    <!-- Profile -->
    <section class="panel p-6 sm:p-9" aria-labelledby="profile-title">
      <h2 id="profile-title" class="text-2xl sm:text-3xl">Profile</h2>
      <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
        <div><dt class="label">Email</dt><dd class="text-silver-100">{access.email}</dd></div>
        <div><dt class="label">Username</dt><dd class="text-silver-100">{access.username}</dd></div>
      </dl>
      {access.isHost ? (
        <p class="mt-6 text-sm text-silver-400">The host’s name is fixed as “AK (host)”.</p>
      ) : (
        <form method="post" class="mt-8 grid gap-4 border-t border-silver-100/10 pt-8 sm:grid-cols-[1fr_auto] sm:items-start" novalidate>
          <input type="hidden" name="action" value="username" />
          {msg.username && <div class="sm:col-span-2"><Alert tone={msg.username.tone}>{msg.username.text}</Alert></div>}
          <Field label="New username" name="username" autocomplete="username" required maxlength={20} hint={USERNAME_HELP} error={errors.username} />
          <button type="submit" class="btn-ghost sm:mt-7">Change username</button>
        </form>
      )}
    </section>

    <!-- Tracking -->
    {!access.isHost && (
      <section id="tracking" class="panel scroll-mt-28 p-6 sm:p-9" aria-labelledby="tracking-title">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="tracking-title" class="text-2xl sm:text-3xl">Performance tracking</h2>
          <span class:list={['rounded-full px-3 py-1 text-xs font-medium tracking-wide', access.trackingEnabled ? 'bg-[#5f8ad3]/15 text-[#bcd0f2] ring-1 ring-[#5f8ad3]/40' : 'bg-silver-100/5 text-silver-300 ring-1 ring-silver-100/15']}>
            {access.trackingEnabled ? `On since ${formatDate(access.trackingConsentedAt!.slice(0, 10))}` : 'Off'}
          </span>
        </div>
        {msg.tracking && <div class="mt-6"><Alert tone={msg.tracking.tone}>{msg.tracking.text}</Alert></div>}
        <div class="mt-6"><HostVisibility /></div>

        {access.trackingEnabled ? (
          <div class="mt-8 grid gap-6 border-t border-silver-100/10 pt-8 lg:grid-cols-2">
            <form method="post">
              <input type="hidden" name="action" value="tracking_off" />
              <p class="text-sm text-silver-300">Hide your results and stop new ones being linked to you.</p>
              <button type="submit" class="btn-ghost mt-4">Turn tracking off</button>
            </form>
            <form method="post" novalidate>
              <input type="hidden" name="action" value="unlink" />
              <p class="text-sm text-silver-300">Remove every past result from your account permanently. This can’t be undone.</p>
              <label class="mt-4 flex items-start gap-3 text-sm text-silver-200">
                <input type="checkbox" name="confirm_unlink" value="yes" class="mt-1 size-4 accent-[#d3707f]" />
                I understand my history will be removed from my account.
              </label>
              {errors.unlink && <p class="field-error">{errors.unlink}</p>}
              <button type="submit" class="btn-danger mt-4">Remove my history</button>
            </form>
          </div>
        ) : (
          <form method="post" class="mt-8 border-t border-silver-100/10 pt-8" novalidate>
            <input type="hidden" name="action" value="tracking_on" />
            <label class="flex items-start gap-3 text-sm text-silver-200">
              <input type="checkbox" name="consent" value="yes" class="mt-1 size-4 accent-[#5f8ad3]" aria-describedby={errors.consent ? 'consent-error' : undefined} />
              I’ve read the above and agree to the host recording my session results and linking them to my account.
            </label>
            {errors.consent && <p id="consent-error" class="field-error">{errors.consent}</p>}
            <button type="submit" class="btn-primary mt-6">Turn tracking on</button>
          </form>
        )}
      </section>
    )}

    {access.isHost && (
      <section class="panel p-6 sm:p-9" aria-labelledby="mfa-title">
        <h2 id="mfa-title" class="text-2xl sm:text-3xl">Two-factor authentication</h2>
        <p class="mt-4 text-sm leading-relaxed text-silver-300">
          The host account must use an authenticator app. {access.mfaVerified ? 'This session is verified.' : 'This session isn’t verified yet.'}
        </p>
        <a href="/host/mfa" class="btn-ghost mt-6">Manage two-factor</a>
      </section>
    )}

    <!-- Password -->
    <section class="panel p-6 sm:p-9" aria-labelledby="password-title">
      <h2 id="password-title" class="text-2xl sm:text-3xl">Password</h2>
      <form method="post" class="mt-6 grid gap-5 sm:grid-cols-3" novalidate>
        <input type="hidden" name="action" value="password" />
        {msg.password && <div class="sm:col-span-3"><Alert tone={msg.password.tone}>{msg.password.text}</Alert></div>}
        <Field label="Current password" name="current_password" type="password" autocomplete="current-password" required error={errors.current_password} />
        <Field label="New password" name="new_password" type="password" autocomplete="new-password" required minlength={10} hint={PASSWORD_HELP} error={errors.new_password} />
        <Field label="Confirm new password" name="confirm_password" type="password" autocomplete="new-password" required error={errors.confirm_password} />
        <div class="sm:col-span-3"><button type="submit" class="btn-ghost">Change password</button></div>
      </form>
    </section>

    <!-- Email -->
    <section class="panel p-6 sm:p-9" aria-labelledby="email-title">
      <h2 id="email-title" class="text-2xl sm:text-3xl">Email address</h2>
      <p class="mt-3 text-sm text-silver-400">For your security, the change needs confirming from both your current and your new address.</p>
      <form method="post" class="mt-6 grid gap-5 sm:grid-cols-2" novalidate>
        <input type="hidden" name="action" value="email" />
        {msg.email && <div class="sm:col-span-2"><Alert tone={msg.email.tone}>{msg.email.text}</Alert></div>}
        <Field label="New email" name="new_email" type="email" autocomplete="email" required error={errors.new_email} />
        <Field label="Current password" name="current_password_email" type="password" autocomplete="current-password" required error={errors.current_password_email} />
        <div class="sm:col-span-2"><button type="submit" class="btn-ghost">Change email</button></div>
      </form>
    </section>

    <!-- Delete -->
    {!access.isHost && (
      <section class="panel border-[#d3707f]/25 p-6 sm:p-9" aria-labelledby="delete-title">
        <h2 id="delete-title" class="text-2xl sm:text-3xl">Delete account</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-silver-300">
          This permanently deletes your login, email address, username and consent record. Any recorded
          results are detached from you and kept only as anonymous amounts in the host’s table records.
          See the <a class="link" href="/privacy">privacy notice</a> for details.
        </p>
        {msg.delete && <div class="mt-6"><Alert tone={msg.delete.tone}>{msg.delete.text}</Alert></div>}
        <form method="post" class="mt-6 grid gap-5 sm:grid-cols-2" novalidate>
          <input type="hidden" name="action" value="delete" />
          <Field label={`Type “${access.username}” to confirm`} name="confirm_username" autocomplete="off" required error={errors.confirm_username} />
          <Field label="Current password" name="current_password_delete" type="password" autocomplete="current-password" required error={errors.current_password_delete} />
          <label class="flex items-start gap-3 text-sm text-silver-200 sm:col-span-2">
            <input type="checkbox" name="confirm_delete" value="yes" class="mt-1 size-4 accent-[#d3707f]" />
            I understand this can’t be undone.
          </label>
          {errors.confirm_delete && <p class="field-error sm:col-span-2">{errors.confirm_delete}</p>}
          <div class="sm:col-span-2"><button type="submit" class="btn-danger">Delete my account</button></div>
        </form>
      </section>
    )}
  </div>
</PortalLayout>
