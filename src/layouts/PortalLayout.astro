---
/**
 * The site's one layout, for every page (home, About the Club, member area,
 * host area). Kept deliberately simple:
 *
 *   Header:  logo · About the Club · Log in / Sign up (or Log out)
 *   Members: on desktop the main links sit in the header; on phones they're
 *            in a bottom tab bar (Games, Dashboard, Poker Log, Account).
 *
 * Pre-built pages (About, Privacy) don't know who is signed in, so they show
 * the signed-out header and a tiny script swaps in "My games" when the
 * harmless akc_member hint cookie is present.
 */
import BaseLayout from './BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { site, instagramUrl } from '../config/site';
import type { Access } from '../lib/access';

export type NavKey = 'home' | 'dashboard' | 'games' | 'log' | 'account' | 'host' | 'auth' | 'about';

interface Props {
  title: string;
  access?: Access | null;
  /** Highlights the current nav item. */
  current?: NavKey;
  width?: 'narrow' | 'wide';
  /** Public pages (home, About) may be indexed by search engines. */
  indexable?: boolean;
  description?: string;
  /** Full document title (otherwise "<title> · AK Cash Club"). */
  fullTitle?: string;
}

const { title, access = null, current, width = 'wide', indexable = false, description, fullTitle } = Astro.props;

const icons = {
  games: 'M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5zM4 9h16M8 3v3m8-3v3',
  dashboard: 'M4 19V9m6 10V5m6 14v-7m4 7H3',
  log: 'M6 4h9l3 3v13H6zM9 10h6M9 14h6M9 18h3',
  account: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 8a7 7 0 0 1 14 0',
  host: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z',
} as const;

const memberLinks = access
  ? [
      { href: '/', label: 'Games', key: 'home', icon: icons.games },
      { href: '/dashboard', label: 'My Dashboard', short: 'Dashboard', key: 'dashboard', icon: icons.dashboard },
      { href: '/poker-log', label: 'My Poker Log', short: 'Poker Log', key: 'log', icon: icons.log },
      { href: '/account', label: 'Account', key: 'account', icon: icons.account },
      ...(access.isHost ? [{ href: '/host', label: 'Host', key: 'host', icon: icons.host }] : []),
    ]
  : [];
const isCurrent = (key: string) => key === current || (key === 'home' && current === 'games');
---

<BaseLayout title={fullTitle ?? `${title} · ${site.name}`} noindex={!indexable} description={description}>
  <a
    href="#portal-main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-silver-100 focus:px-5 focus:py-3 focus:text-sm focus:text-midnight-950"
  >
    Skip to content
  </a>

  <div class="relative flex min-h-dvh flex-col bg-[radial-gradient(90%_40%_at_50%_0%,#12244a_0%,#0a1120_35%,#05070c_75%)]">
    <header class="sticky top-0 z-40 border-b border-silver-100/10 bg-ink/85 backdrop-blur-xl">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-8">
        <a href="/" class="shrink-0 rounded-full" aria-label={`${site.name} home`}>
          <span class="sm:hidden"><Logo showWordmark={false} priority /></span>
          <span class="hidden sm:block"><Logo priority /></span>
        </a>

        {access && (
          <nav aria-label="Members" class="hidden md:block">
            <ul class="flex items-center gap-1 text-sm">
              {memberLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={isCurrent(l.key) ? 'page' : undefined}
                    class:list={[
                      'inline-flex min-h-10 items-center rounded-full px-3.5 transition-colors',
                      isCurrent(l.key) ? 'bg-steel-500/15 text-silver-50 ring-1 ring-steel-400/30' : 'text-silver-300 hover:text-silver-50',
                    ]}
                  >{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="flex items-center gap-1 sm:gap-2">
          <a
            href="/about"
            aria-current={current === 'about' ? 'page' : undefined}
            class:list={['inline-flex min-h-10 items-center rounded-full px-3 text-sm transition-colors', current === 'about' ? 'text-silver-50' : 'text-silver-300 hover:text-silver-50']}
          >About the Club</a>
          {access ? (
            <form method="post" action="/logout">
              <button type="submit" class="inline-flex min-h-10 items-center rounded-full px-3 text-sm text-silver-300 hover:text-silver-50">Log out</button>
            </form>
          ) : (
            current !== 'auth' && (
              <span class="flex items-center gap-1" data-guest-actions>
                <a href="/login" class="inline-flex min-h-10 items-center rounded-full px-3 text-sm text-silver-100 hover:text-silver-50">Log in</a>
                <a href="/signup" class="btn-primary hidden min-h-10 px-5 sm:inline-flex">Sign up</a>
              </span>
            )
          )}
        </div>
      </div>
    </header>

    <main
      id="portal-main"
      class:list={['mx-auto w-full flex-1 px-4 pt-8 sm:px-8 sm:pt-12', access ? 'pb-28 md:pb-20' : 'pb-16', width === 'narrow' ? 'max-w-lg' : 'max-w-6xl']}
    >
      <slot />
    </main>

    <footer class:list={['border-t border-silver-100/10', access && 'pb-20 md:pb-0']}>
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-xs leading-relaxed text-silver-500 sm:flex-row sm:items-start sm:justify-between sm:px-8">
        <p>
          © {new Date().getFullYear()} {site.name} · A private home game in {site.city}. No online gambling and no payments.
          Please play responsibly: <a class="underline underline-offset-2 hover:text-silver-300" href="https://www.connexontario.ca/" target="_blank" rel="noopener">ConnexOntario</a>, 1-866-531-2600.
        </p>
        <p class="flex shrink-0 gap-4">
          <a class="hover:text-silver-300" href="/about">About</a>
          <a class="hover:text-silver-300" href="/privacy">Privacy</a>
          <a class="hover:text-silver-300" href={instagramUrl} target="_blank" rel="noopener">@{site.instagramHandle}</a>
        </p>
      </div>
    </footer>

    {access && (
      <nav aria-label="Members (mobile)" class="fixed inset-x-0 bottom-0 z-40 border-t border-silver-100/10 bg-ink/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl md:hidden">
        <ul class="mx-auto flex max-w-lg">
          {memberLinks.map((l) => (
            <li class="flex-1">
              <a
                href={l.href}
                aria-current={isCurrent(l.key) ? 'page' : undefined}
                class:list={['flex min-h-16 flex-col items-center justify-center gap-1 text-[0.68rem] tracking-wide', isCurrent(l.key) ? 'text-silver-50' : 'text-silver-400']}
              >
                <svg viewBox="0 0 24 24" class:list={['size-6', isCurrent(l.key) ? 'text-steel-300' : '']} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={l.icon} /></svg>
                {'short' in l && l.short ? l.short : l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  {!access && current !== 'auth' && (
    <script is:inline>
      // Pre-built pages: a signed-in visitor gets "My games" instead of Log in / Sign up.
      if (document.cookie.split('; ').includes('akc_member=1')) {
        var g = document.querySelector('[data-guest-actions]');
        if (g) g.innerHTML = '<a href="/" class="inline-flex min-h-10 items-center rounded-full px-3 text-sm text-silver-100">My games</a>';
      }
    </script>
  )}
</BaseLayout>
