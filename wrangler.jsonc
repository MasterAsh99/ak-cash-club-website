{
  // Cloudflare Workers config.
  // Workers Builds runs `npm run build`, then `npx wrangler deploy`.
  // Pre-built pages are served as static assets; member pages (login,
  // dashboard, host area) are rendered on demand by the Astro server entry.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ak-cash-club-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Keep variables set in the Cloudflare dashboard when deploying. Without this,
  // every deploy would delete dashboard variables that aren't listed below.
  "keep_vars": true,

  // Non-secret settings. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are set as
  // Secrets in the Cloudflare dashboard (see SETUP.md), not here.
  "vars": {
    "PUBLIC_SITE_URL": "https://akcashclub.com"
  },

  // Coarse abuse protection for login, sign-up and password-reset forms.
  // (Supabase Auth applies its own limits as well.)
  "ratelimits": [
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_EMAIL_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
